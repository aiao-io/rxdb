  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git",
      "czConfig": "./scripts/commitizen.mjs"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx",
      "electron",
      "sharp",
      "@swc/core",
      "esbuild",
      "@parcel/watcher",
      "lmdb",
      "unrs-resolver",
      "msgpackr-extract"
    ],
    "overrides": {
      "@codemirror/language": "^6.12.4",
      "@codemirror/state": "^6.7.2",
      "@codemirror/view": "^6.43.10",
      "@angular/common": "22.1.4",
      "@angular/core": "22.1.4",
      "@angular/forms": "22.1.4",
      "@angular/platform-browser": "22.1.4",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "vue": "^3.5.42"
    },
    "patchedDependencies": {
      "typescript@6.0.3": "patches/typescript@6.0.3.patch"
    }
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "website",
    "benchmarks",
    "!examples/*"
  ],
  "packageManager": "pnpm@10.33.0"
}
