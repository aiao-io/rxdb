  "scripts": {
    "check-commit": "node ./scripts/commit-lint.mjs",
    "check-format": "nx format:check",
    "check-workspace": "node scripts/check-workspace.mjs",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "format": "nx format:write",
    "postinstall": "pnpm check-workspace",
    "pre-commit": "pnpm check-commit",
    "pre-push": "pnpm check-commit",
    "preinstall": "node ./scripts/audit/wa-sqlite-integrity.mjs && node ./scripts/preinstall.mjs",
    "prepare": "is-ci || husky",
    "publish-local": "nx release publish --registry=http://localhost:4873",
    "publish": "nx release publish --registry=https://registry.npmjs.org",
    "test-all": "nx affected -t lint typecheck test test-memory test-browser build audit-lazy-backend e2e --output-style=static --skipRemoteCache --parallel=4 --nxBail",
    "test-all:log": "node ./scripts/test-all-log.mjs",
    "test-packages": "nx run-many -t lint typecheck test test-memory test-browser build e2e --projects='packages/*' --output-style=static --skipRemoteCache --parallel=4 --nxBail",
    "audit:conditions": "node scripts/audit/package-runtime-conditions.mjs",
    "audit:build-entries": "node scripts/audit/subpath-build-entries.mjs",
    "audit:api-surface": "node scripts/audit/api-surface.mjs --check",
    "audit:api-surface:update": "node scripts/audit/api-surface.mjs --update",
    "audit:coverage": "node scripts/audit/coverage-check.mjs --check",
    "audit:coverage:update": "node scripts/audit/coverage-check.mjs --update",
    "audit:wa-sqlite": "node scripts/audit/wa-sqlite-integrity.mjs",
    "audit:action-pins": "node scripts/audit/workflow-action-pins.mjs",
    "audit:lazy-backend": "node scripts/audit/desktop-lazy-backend.mjs",
    "audit:suite-callsites": "node scripts/audit/working-tree-suite-callsites.mjs",
    "audit:callsite-drift": "node scripts/audit/working-tree-callsite-drift.mjs",
    "audit:core-boundary": "node scripts/audit/core-plugin-boundary.mjs",
    "audit:docs-plugins": "node scripts/audit/docs-plugin-surface.mjs",
    "audit:requirements": "node scripts/audit/requirements-consistency.mjs --check",
    "audit:requirements:update": "node scripts/audit/requirements-consistency.mjs --update",
    "check-migration-release-gate": "node scripts/check-migration-release-gate.mjs --check",
    "test-scripts": "nx run @aiao/source:test-scripts",
    "coverage:serve": "node ./scripts/coverage-serve.mjs",
    "dep-graph": "nx graph",
    "affected:build": "nx affected:build --parallel=4",
    "affected:test": "nx affected:test --parallel=4",
    "reset": "nx reset",
    "build-packages": "nx run-many -t build --projects=packages/*",
    "build": "nx run-many -t build --tui=true",
    "update": "nx migrate latest",
    "audit:package-graph": "nx run @aiao/source:audit-package-graph",
    "verify:ai-example": "nx run @aiao/source:ai-example",
    "verify:release-consumers": "nx run @aiao/source:release-consumers"
  },
