{
  "name": "dev-rxdb-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "@aiao/rxdb-adapter-miniprogram 的 Taro + React 微信小程序演示",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "new": "taro new",
    "typecheck": "tsc --noEmit",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-miniprogram": "workspace:*",
    "@subframe7536/sqlite-wasm": "1.3.1",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-alipay": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-harmony-hybrid": "4.3.0",
    "@tarojs/plugin-platform-jd": "4.3.0",
    "@tarojs/plugin-platform-qq": "4.3.0",
    "@tarojs/plugin-platform-swan": "4.3.0",
    "@tarojs/plugin-platform-tt": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aiao/rxdb-taro": "workspace:*",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-generator": "4.3.0",
    "@tarojs/vite-runner": "4.3.0",
    "@types/minimatch": "^5.1.2",
    "@types/react": "^18.3.31",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.29",
    "react-refresh": "^0.14.2",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "vite": "^6.4.3"
  }
}
