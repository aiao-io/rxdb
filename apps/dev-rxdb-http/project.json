{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dev-rxdb-http",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/dev-rxdb-http/src",
  "tags": ["angular-app"],
  "//": [
    "端口 4300：既有 demo 占了 4200 / 4201 / 4202 / 4203，参考后端在 4301。前后端**故意不同源**，AC#9～#12 全靠这一条。",
    "serve 不配 COOP / COEP —— 这是本 app 唯一一处刻意不抄 dev-rxdb-angular 的地方。`require-corp` 会把跨源资源全挡回去，跨源诊断的现象就分不清是 CORS 还是 COEP 造成的了。代价是 wa-sqlite 用不了 SharedArrayBuffer，本 demo 的三条 VFS 路径都不需要它。"
  ],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dev-rxdb-http/public"
          },
          {
            "glob": "**/*.wasm",
            "input": "./node_modules/wa-sqlite/dist",
            "output": "./wa-sqlite/"
          }
        ],
        "browser": "apps/dev-rxdb-http/src/main.ts",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/dev-rxdb-http",
        "polyfills": [],
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": ["color-functions", "global-builtin", "import"]
          }
        },
        "styles": ["apps/dev-rxdb-http/src/styles.scss"],
        "tsConfig": "apps/dev-rxdb-http/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "2mb",
              "maximumWarning": "1mb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "define": {
            "import.meta.env": "{\"MODE\":\"production\",\"BASE_URL\":\"/\",\"DEV\":false,\"PROD\":true,\"SSR\":false}"
          },
          "outputHashing": "all"
        }
      }
    },
    "serve": {
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4300
      },
      "configurations": {
        "development": {
          "buildTarget": "dev-rxdb-http:build:development",
          "host": "0.0.0.0"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "dev-rxdb-http:build",
        "port": 4300,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-http/browser",
        "watch": false
      }
    },
    "serve-e2e": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "port": 4300,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-http/browser",
        "watch": false
      }
    }
  }
}
