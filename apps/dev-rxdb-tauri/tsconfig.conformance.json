{
  // US-210：Rust 宿主一致性套件。与 tsconfig.spec.json 分开，因为它跑在 node 环境、
  // 不经过 Angular 编译器，也不需要 `src/test-setup.ts`。
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    "outDir": "./out-tsc/conformance",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": ["vitest.conformance.mts", "conformance/**/*.ts"],
  "references": [
    {
      "path": "../../packages/rxdb/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-test/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-desktop/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-sqlite-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-encrypted/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-storage/tsconfig.lib.json"
    },
    {
      "path": "../../packages/utils/tsconfig.lib.json"
    }
  ]
}
