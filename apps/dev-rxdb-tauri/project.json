{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dev-rxdb-tauri",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/dev-rxdb-tauri/src",
  "tags": ["angular-app"],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dev-rxdb-tauri/public"
          },
          {
            "glob": "**/*.wasm",
            "input": "./node_modules/wa-sqlite/dist",
            "output": "./wa-sqlite/"
          }
        ],
        "browser": "apps/dev-rxdb-tauri/src/main.ts",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/dev-rxdb-tauri",
        "polyfills": [],
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": ["color-functions", "global-builtin", "import"]
          }
        },
        "styles": ["apps/dev-rxdb-tauri/src/styles.scss"],
        "tsConfig": "apps/dev-rxdb-tauri/tsconfig.app.json",
        "webWorkerTsConfig": "apps/dev-rxdb-tauri/tsconfig.worker.json",
        "allowedCommonJsDependencies": ["ms"]
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "2mb",
              "maximumWarning": "1mb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "outputHashing": "all"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tauri dev"],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 1420
      },
      "configurations": {
        "development": {
          "buildTarget": "dev-rxdb-tauri:build:development",
          "host": "127.0.0.1",
          "port": 1420
        },
        "production": {
          "buildTarget": "dev-rxdb-tauri:build:production"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "dev-rxdb-tauri:build",
        "port": 1420,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-tauri/browser"
      }
    },
    "tauri-build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["tauri build --ci"],
        "parallel": false
      },
      "dependsOn": ["cargo-check", "cargo-clippy", "cargo-test"]
    },
    "tauri-package-release": {
      "// 不继承 tauri-build 的 dependsOn": "cargo-check / cargo-clippy / cargo-test 已在 PR 门禁跑过；发布 workflow 里 ×3 平台重跑一遍是纯亏。",
      "// --no-bundle": "前端产物照样编进二进制（frontendDist 不变），但省掉 macOS 签名、Windows 安装器、以及 Linux AppImage 构建期下载 linuxdeploy + 依赖 FUSE 这个 Tauri CI 最经典的 flaky 源。代价：这条路**不验证安装包本身**（Info.plist / MSI / NSIS）——AC#9 要的是「启动产物、写入、退出、再次启动」，release 二进制满足，但读者不该靠猜。",
      "// 不设 cache": "输入面横跨 Angular 源码 + Rust 源码 + tauri.conf.json + icons，手写一份 inputs 漏一项就会拿旧二进制跑出绿的 smoke —— 正是本轮在防的那种静默绿。重复执行的代价由 nx 的 build 缓存与 cargo 增量编译兜住，不必再叠一层。",
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/dev-rxdb-tauri",
        "command": "tauri build --ci --no-bundle",
        "parallel": false
      },
      "metadata": {
        "description": "US-210 AC#9：跨进程 smoke 用的 release 产物（src-tauri/target/release/dev-rxdb-tauri[.exe]）"
      }
    },
    "tauri-update": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["cargo update"],
        "cwd": "apps/dev-rxdb-tauri/src-tauri",
        "parallel": false
      }
    },
    "cargo-check": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock",
        "{projectRoot}/src-tauri/tauri.conf.json",
        "{projectRoot}/src-tauri/capabilities/**/*.json"
      ],
      "options": {
        "cwd": "apps/dev-rxdb-tauri/src-tauri",
        "command": "cargo check --locked --all-targets",
        "parallel": false
      },
      "metadata": {
        "description": "TAURI-FRESH-01：Rust 侧的类型/编译门禁"
      }
    },
    "cargo-clippy": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock",
        "{projectRoot}/src-tauri/tauri.conf.json",
        "{projectRoot}/src-tauri/capabilities/**/*.json"
      ],
      "options": {
        "cwd": "apps/dev-rxdb-tauri/src-tauri",
        "command": "cargo clippy --locked --all-targets -- -D warnings",
        "parallel": false
      },
      "metadata": {
        "description": "TAURI-FRESH-01：Rust 侧的 lint 门禁（零警告）"
      }
    },
    "build-test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock"
      ],
      "outputs": [
        "{projectRoot}/src-tauri/target/debug/rxdb_host_stdio",
        "{projectRoot}/src-tauri/target/debug/rxdb_host_stdio.exe"
      ],
      "options": {
        "cwd": "apps/dev-rxdb-tauri/src-tauri",
        "command": "cargo build --locked --bin rxdb_host_stdio",
        "parallel": false
      },
      "metadata": {
        "description": "US-210：一致性套件驱动的 stdio 宿主二进制（不进产品包）"
      }
    },
    "test-conformance": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-test-host", "^build"],
      "inputs": [
        "{projectRoot}/conformance/**/*.ts",
        "{projectRoot}/vitest.conformance.mts",
        "{projectRoot}/src-tauri/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock",
        "^production"
      ],
      "options": {
        "cwd": "apps/dev-rxdb-tauri",
        "command": "vitest run --config vitest.conformance.mts",
        "parallel": false
      },
      "metadata": {
        "description": "US-210 AC#2/#3/#5/#7 + US-505 AC#2：Rust 引擎跑 21 个共享套件 + 5 个加密套件，Rust 文件宿主跑 storage 后端一致性套件"
      }
    },
    "cargo-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src-tauri/**/*.rs",
        "{projectRoot}/src-tauri/Cargo.toml",
        "{projectRoot}/src-tauri/Cargo.lock",
        "{projectRoot}/src-tauri/tauri.conf.json",
        "{projectRoot}/src-tauri/capabilities/**/*.json"
      ],
      "options": {
        "cwd": "apps/dev-rxdb-tauri/src-tauri",
        "command": "cargo test --locked",
        "parallel": false
      },
      "metadata": {
        "description": "TAURI-FRESH-01：Rust 单元测试"
      }
    }
  }
}
