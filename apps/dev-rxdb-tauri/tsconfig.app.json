{
  "//include": "tauri.conf.json 是 src/devtools/main.ts 的面板版本来源（DEVTOOLS_PANEL_VERSION）。composite 工程必须把被 import 的文件也列进来，否则 TS6307。",
  "//types": "vite/client 为 src/devtools/main.ts 的 configureLogger(import.meta.env.DEV) 提供 ImportMeta.env 类型。该入口由 vite 构建（build-devtools），但同样被本 app 的 TS program 一并 typecheck。注释键必须在顶层：Angular 编译器不接受 compilerOptions 里的未知键（TS5025）。",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src-tauri/tauri.conf.json"],
  "references": [
    {
      "path": "../../modules/rxdb-devtools-panel/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-wa-sqlite/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-test/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-graph/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-devtools/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-tauri/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-storage/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb/tsconfig.lib.json"
    },
    {
      "path": "../../modules/angular/tsconfig.lib.json"
    },
    {
      "path": "../../modules/angular-todo/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-angular/tsconfig.lib.json"
    },
    {
      "path": "../../packages/utils/tsconfig.lib.json"
    }
  ]
}
