{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 一个 Worker 承载整套服务端：静态资源（Angular 构建产物）、信令 Durable Object、R2 服务器回退。
  "name": "aiao-rxdb-p2p",
  "main": "server/index.ts",
  // 不早于 2026-04-07：休眠 WebSocket 由运行时自动应答关闭帧（web_socket_auto_reply_to_close）。
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/apps/dev-rxdb-p2p/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/app-config.js"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "SignalingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingRoom"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "aiao-rxdb-p2p-files" }],
  // 公开配置；本地开发由 scripts/dev-vars.mjs 生成的 .dev.vars 覆盖。签票私钥 TICKET_PRIVATE_JWK 是 secret，
  // 线上用 `wrangler secret put TICKET_PRIVATE_JWK` 写入，不进这个文件。
  "vars": {
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": ""
  },
  "observability": { "enabled": false }
}
