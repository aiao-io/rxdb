{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 一个 Worker 承载整套服务端：静态资源（Angular 构建产物）、信令 Durable Object、R2 服务器回退。
  "name": "aiao-rxdb-p2p",
  "main": "server/index.ts",
  // 不早于 2026-04-07：休眠 WebSocket 由运行时自动应答关闭帧（web_socket_auto_reply_to_close）。
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/apps/dev-rxdb-p2p/browser",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/app-config.js"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "SignalingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalingRoom"] }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "aiao-rxdb-p2p-files" }],
  // SUPABASE_URL / SUPABASE_ANON_KEY / TICKET_PRIVATE_JWK 都是 Worker secret，不进这个文件，重新部署也不会清掉：
  // 线上用 scripts/deploy-secrets.mjs | wrangler secret bulk 写入，本地开发由 scripts/dev-vars.mjs 生成 .dev.vars。
  "observability": { "enabled": false }
}
