{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dev-rxdb-supabase",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/dev-rxdb-supabase/src",
  "tags": ["angular-app"],
  "targets": {
    "build": {
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "allowedCommonJsDependencies": ["@supabase/postgrest-js", "ms"],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dev-rxdb-supabase/public"
          },
          {
            "glob": "**/*.wasm",
            "input": "./node_modules/wa-sqlite/dist",
            "output": "./wa-sqlite/"
          },
          {
            "glob": "**/pglite.{wasm,data}",
            "input": "./node_modules/@electric-sql/pglite/dist",
            "output": "./pglite/"
          }
        ],
        "browser": "apps/dev-rxdb-supabase/src/main.ts",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/dev-rxdb-supabase",
        "polyfills": [],
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": ["color-functions", "global-builtin", "import"]
          }
        },
        "styles": ["apps/dev-rxdb-supabase/src/styles.scss"],
        "tsConfig": "apps/dev-rxdb-supabase/tsconfig.app.json"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "2.1mb",
              "maximumWarning": "1.8mb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "define": {
            "import.meta.env": "{\"MODE\":\"production\",\"BASE_URL\":\"/\",\"DEV\":false,\"PROD\":true,\"SSR\":false}"
          },
          "outputHashing": "all"
        }
      }
    },
    "audit-secrets": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/audit-build-credentials.mjs dist/apps/dev-rxdb-supabase/browser"
      }
    },
    "serve": {
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4203
      },
      "configurations": {
        "development": {
          "buildTarget": "dev-rxdb-supabase:build:development",
          "host": "0.0.0.0"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "dev-rxdb-supabase:build",
        "port": 4203,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-supabase/browser",
        "watch": false
      }
    },
    "serve-e2e": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "readyWhen": {
        "signal": true
      },
      "options": {
        "port": 4203,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-supabase/browser",
        "watch": false
      }
    },
    "serve-local": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/serve.mjs local"
      }
    },
    "serve-remote": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/serve.mjs remote"
      }
    },
    "dev": {
      "continuous": true,
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "dev-serve",
          "waitFor": "ready"
        },
        {
          "target": "dev-dashboard",
          "waitFor": "ready"
        }
      ],
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/dev/supervise.mjs node apps/dev-rxdb-supabase/scripts/dev/open-dashboard.mjs"
      },
      "metadata": {
        "description": "一键本地开发：起本 checkout 的隔离 Supabase 栈与 Studio，应用连上它热更新运行，全部就绪后打开测试起始页 http://127.0.0.1:4204/（AIAO_DEV_OPEN=false 不自动打开）"
      }
    },
    "dev-ports": {
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/dev/check-ports.mjs"
      }
    },
    "dev-studio": {
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["rxdb-adapter-supabase"],
          "target": "test-env"
        }
      ],
      "options": {
        "command": "docker/supabase-ci-compose.sh up -d --no-deps --wait --wait-timeout 180 meta studio"
      }
    },
    "dev-serve": {
      "continuous": true,
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": [
        "dev-ports",
        {
          "projects": ["rxdb-adapter-supabase"],
          "target": "test-env"
        }
      ],
      "readyWhen": {
        "url": "http://127.0.0.1:4203/"
      },
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/dev/supervise.mjs node apps/dev-rxdb-supabase/scripts/serve.mjs stack"
      }
    },
    "dev-dashboard": {
      "continuous": true,
      "cache": false,
      "executor": "nx:run-commands",
      "dependsOn": ["dev-ports", "dev-studio"],
      "readyWhen": {
        "url": "http://127.0.0.1:4204/"
      },
      "options": {
        "command": "node apps/dev-rxdb-supabase/scripts/dev/supervise.mjs node apps/dev-rxdb-supabase/scripts/dev/dashboard.mjs"
      }
    },
    "dev-test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["{projectRoot}/scripts/**/*", "{projectRoot}/project.json"],
      "options": {
        "command": "node --test \"apps/dev-rxdb-supabase/scripts/dev/*.spec.mjs\""
      }
    },
    "test": {
      "dependsOn": ["^build", "dev-test"]
    }
  }
}
