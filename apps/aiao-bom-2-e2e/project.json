{
  "name": "aiao-bom-2-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/aiao-bom-2-e2e/src",
  "implicitDependencies": [
    "aiao-bom-2",
    "aiao-bom",
    "aiao-bom-e2e"
  ],
  "// targets": "to see all targets run: nx show project aiao-bom-2-e2e --web",
  "targets": {
    "e2e": {
      "dependsOn": [
        "aiao-bom-2:build",
        "aiao-bom:build"
      ],
      "parallelism": false
    },
    "install-browsers": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright install firefox webkit",
        "cwd": "apps/aiao-bom-2-e2e"
      }
    }
  }
}
