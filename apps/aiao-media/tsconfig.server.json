{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "es2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "server/cloudflare/**/*.ts"
  ]
}
