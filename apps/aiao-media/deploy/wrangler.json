{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "../dist/browser",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-10-23",
  "main": "local-first-worker.mjs",
  "name": "aiao-media",
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "media.aiao.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_PROVIDER_BASE_URLS": "[]"
  },
  "workers_dev": true
}
