{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "assets": {
    "directory": "../dist/browser",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_PLATFORM",
        "class_name": "PlatformCoordinator"
      }
    ]
  },
  "main": "../server/cloudflare/local-first-worker.mjs",
  "migrations": [
    {
      "tag": "media-platform-v1",
      "new_sqlite_classes": ["PlatformCoordinator"]
    }
  ],
  "name": "aiao-media",
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "media.aiao.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_PROVIDER_BASE_URLS": "[]",
    "MEDIA_ALLOW_DESKTOP_ORIGIN": "true"
  },
  "workers_dev": true
}
