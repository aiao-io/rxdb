# The local-first frontend works without an .env file.
# Copy to the ignored local .env only when these capabilities are needed.
# Real provider verification has no user-imposed quota; secrets stay local.
AIAO_IMAGE_BASE_URL=
AIAO_IMAGE_API_KEY=
AIAO_IMAGE_MODEL=

# Comma-separated HTTPS API prefixes approved for the same-origin relay.
# Only public prefixes enter Worker configuration; the provider Key does not.
AIAO_RELAY_PROVIDER_BASE_URLS=

# Optional account service: public project URL + anon/publishable key only.
# Never put a service_role or secret key in these browser-facing variables.
AIAO_SUPABASE_URL=
AIAO_SUPABASE_ANON_KEY=

# Local Supabase: bun --no-env-file nx run supabase:serve
# Credentials/ports are generated separately in infra/supabase/.env.
# Do not copy local server secrets into this frontend file.
# Provider Keys in this file are only for local verification tooling;
# end users enter their own Keys in the browser, never in deployed server env.
