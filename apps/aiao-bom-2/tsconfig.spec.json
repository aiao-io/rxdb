{
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "emitDeclarationOnly": false
  },
  "extends": "./tsconfig.json",
  "files": ["src/test-setup.ts"],
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/rxdb-plugin-bom/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-wa-sqlite/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb/tsconfig.lib.json"
    },
    {
      "path": "../../modules/bom-workspace/tsconfig.lib.json"
    }
  ]
}
