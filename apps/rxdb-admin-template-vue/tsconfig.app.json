{
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "lib": ["dom", "es2024"],
    "types": ["node", "vite/client"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/test-setup.ts"
  ],
  "extends": "../../tsconfig.base.json",
  "include": ["app.config.json", "src/**/*.ts", "src/**/*.vue"],
  "references": [
    {
      "path": "../../packages/rxdb-test/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-search-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-search/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-plugin-history/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-model-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-model/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-i18n-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-i18n/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-devtools/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-admin-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-adapter-sqlite-wasm/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb/tsconfig.lib.json"
    },
    {
      "path": "../../packages/rxdb-admin/tsconfig.lib.json"
    }
  ]
}
