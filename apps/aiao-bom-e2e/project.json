{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["aiao-bom"],
  "name": "aiao-bom-e2e",
  "projectType": "application",
  "sourceRoot": "apps/aiao-bom-e2e/src",
  "tags": ["e2e", "scope:bom"],
  "targets": {
    "e2e": {
      "dependsOn": ["aiao-bom:build"],
      "inputs": ["default", "^production", "{projectRoot}/src/**/*.spec.ts", "{projectRoot}/playwright.config.ts"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/aiao-bom-e2e",
        "command": "eslint . --max-warnings=0"
      }
    }
  }
}
