{
  "compilerOptions": {
    // 后端直接由 `node src/main.ts` 运行，靠 Node 26 的类型剥离执行 TS，永远不经过打包器。
    // 因此源码里的相对导入必须写全 `.ts` 后缀（Node 的 ESM 解析不补后缀），
    // 而 allowImportingTsExtensions 就是让 tsc 认这种写法的开关。
    "allowImportingTsExtensions": true,
    // 类型剥离只删不改：enum / namespace / 参数属性这些「会生成运行时代码」的语法
    // 在 Node 下直接抛错。打开这个开关，让 typecheck 在 CI 里先拦住，而不是等运行时炸。
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
