{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["@cloudflare/workers-types"]
  },
  "exclude": ["server/**/*.spec.ts"],
  "include": ["server/**/*.ts"]
}
