{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dev-rxdb-electron",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/dev-rxdb-electron/src",
  "tags": ["angular-app", "electron-app"],
  "targets": {
    "build": {
      "//": "ELEC-21：真正的构建在 ng-build；这层只为把 NG_BUILD_OPTIMIZE_CHUNKS=0 传进去。该开关是 @angular/build 的环境变量，没有对应的 builder 选项，所以只能包一层。理由见 renderer-shell.spec.ts 的同名用例。",
      "//dependsOn": "dependsOn 与命令末尾的 --excludeTaskDependencies 是一对：依赖由**外层**这一个 nx 进程建好，内层只跑 ng-build 自己。少了后者，内层会把 ng-build 的 ^build 再展开一遍，两个 nx 同时往 packages/*/dist 里写，读那批 dist 的兄弟任务会随机炸。见 renderer-shell.spec.ts 里同名用例的排障记录。",
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "corepack pnpm exec nx run dev-rxdb-electron:ng-build --excludeTaskDependencies",
        "env": {
          "NG_BUILD_OPTIMIZE_CHUNKS": "0"
        }
      }
    },
    "ng-build": {
      "defaultConfiguration": "production",
      "executor": "@angular/build:application",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "allowedCommonJsDependencies": [
          "ms",
          "path-browserify",
          "ts-morph",
          "object-hash",
          "@supabase/postgrest-js",
          "gifuct-js",
          "lodash",
          "eventemitter3",
          "lottie-web",
          "cssfontparser",
          "geojson-dissolve",
          "simplify-geojson",
          "geobuf",
          "pbf"
        ],
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/dev-rxdb-electron/public"
          },
          {
            "glob": "**/*.wasm",
            "input": "./node_modules/wa-sqlite/dist",
            "output": "./wa-sqlite/"
          }
        ],
        "browser": "apps/dev-rxdb-electron/src/main.ts",
        "index": "apps/dev-rxdb-electron/src/index.html",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/apps/dev-rxdb-electron",
        "polyfills": [],
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": ["color-functions", "global-builtin", "import"]
          }
        },
        "styles": ["apps/dev-rxdb-electron/src/styles.scss"],
        "tsConfig": "apps/dev-rxdb-electron/tsconfig.app.json",
        "webWorkerTsConfig": "apps/dev-rxdb-electron/tsconfig.worker.json"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "budgets": [
            {
              "maximumError": "2mb",
              "maximumWarning": "1mb",
              "type": "initial"
            },
            {
              "maximumError": "8kb",
              "maximumWarning": "4kb",
              "type": "anyComponentStyle"
            }
          ],
          "index": {
            "input": "apps/dev-rxdb-electron/src/index.prod.html",
            "output": "index.html"
          },
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "outputHashing": "all"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["prepare-electron-package"],
      "continuous": true,
      "options": {
        "command": "corepack pnpm exec electron dist/apps/dev-rxdb-electron --serve"
      }
    },
    "electron-build": {
      "//": "ELEC-23：tsc 之后必须再跑一次 esbuild，配置见 tools/bundle-desktop-host.mjs（三个调用点共用的唯一定义）。见 desktop-sqlite-bridge.spec.ts。",
      "//electronDist": "同 electron-package-dir：electron-builder 读 electronDist 前先触发 Electron 42+ 的懒下载。必须按相对路径 require，与 electron-builder.json 的 electronDist 指同一份拷贝。",
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "tsc -p tsconfig.serve.json",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/bundle-desktop-host.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/copy-app-manifest.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/stage-external-dependencies.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node -e \"require('../../node_modules/electron')\"",
            "forwardAllArgs": false
          },
          {
            "command": "electron-builder build --publish=never --config electron-builder.json",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/dev-rxdb-electron",
        "parallel": false
      }
    },
    "electron-package-dir": {
      "//": "ELEC-10：只解包不做安装器（--dir），给 e2e 一个可直接启动的真实产物。使用 electron-builder.dir.json 禁用签名（--dir 无需签名）。electron-builder 自带下载缓存，无需手动管理。",
      "//electronDist": "Electron 42+ 的二进制没有 postinstall，首次 require 才懒下载到 node_modules/electron/dist；electron-builder 读 electronDist 之前必须先触发一次，否则 CI 新 runner / 新 clone 上 dist 不存在，直接报 electronDist does not exist。注意必须写成 ../../node_modules/electron 而非裸 'electron'：cwd 是 apps/dev-rxdb-electron，裸 require 会解析到 app 级软链，一旦它与根级软链指向不同版本（升级后 app 级链未刷新），懒下载会落到另一份拷贝，electron-builder 读到的 electronDist 仍然为空。",
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/dev-rxdb-electron/release"],
      "options": {
        "commands": [
          {
            "command": "tsc -p tsconfig.serve.json",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/bundle-desktop-host.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/copy-app-manifest.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node tools/stage-external-dependencies.mjs",
            "forwardAllArgs": false
          },
          {
            "command": "node -e \"require('../../node_modules/electron')\"",
            "forwardAllArgs": false
          },
          {
            "command": "electron-builder build --dir --publish=never --config electron-builder.dir.json",
            "forwardAllArgs": false
          }
        ],
        "cwd": "apps/dev-rxdb-electron",
        "env": {
          "CSC_IDENTITY_AUTO_DISCOVERY": "false"
        },
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "defaultConfiguration": "development",
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4120
      },
      "configurations": {
        "development": {
          "buildTarget": "dev-rxdb-electron:ng-build:development",
          "host": "127.0.0.1"
        },
        "production": {
          "buildTarget": "dev-rxdb-electron:ng-build:production"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "dev-rxdb-electron:build",
        "port": 4120,
        "spa": true,
        "staticFilePath": "dist/apps/dev-rxdb-electron/browser"
      }
    },
    "watch-main": {
      "//": "ELEC-23：dev 模式加载的是同一份 dist 产物，因此 tsc 与 esbuild 必须一起 watch —— 少了后者，main.js 里的 `./desktop-host-bridge.bundle.js` 根本不存在，应用一启动就 Cannot find module。bundle 配置与打包路径共用 tools/bundle-desktop-host.mjs，此处只多传一个 --watch。",
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          {
            "command": "corepack pnpm exec tsc -p apps/dev-rxdb-electron/tsconfig.serve.json --watch",
            "forwardAllArgs": false
          },
          {
            "command": "node apps/dev-rxdb-electron/tools/bundle-desktop-host.mjs --watch",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "prepare-electron-package": {
      "executor": "nx:run-commands",
      "dependsOn": ["serve", "watch-main"],
      "options": {
        "command": "corepack pnpm exec wait-on tcp:4120 dist/apps/dev-rxdb-electron/src-electron/main.js dist/apps/dev-rxdb-electron/src-electron/desktop-host-bridge.bundle.js && mkdir -p dist/apps/dev-rxdb-electron && cp apps/dev-rxdb-electron/package.json dist/apps/dev-rxdb-electron/"
      }
    },
    "audit-lazy-backend": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/audit/desktop-lazy-backend.mjs dev-rxdb-electron"
      }
    }
  }
}
