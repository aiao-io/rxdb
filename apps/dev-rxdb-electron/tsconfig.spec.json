{
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/dev-rxdb-electron-test",
    "types": ["vitest/globals", "node"],
    "rootDir": ".",
    "tsBuildInfoFile": "../../dist/out-tsc/dev-rxdb-electron-test.tsbuildinfo"
  },
  "extends": "./tsconfig.json",
  "include": [
    "src-electron/**/*.spec.ts",
    "src-electron/**/*.ts",
    // desktop-sqlite-bridge.spec.ts 直接 import 这个脚本来断言 bundleOptions，
    // 不列进来 tsc 就报 TS6307（引用了不属于本 project 的文件）。
    "tools/**/*.mjs",
    "src/app/connect-wa-sqlite-adapter.ts",
    "src/app/locale.ts",
    "src/app/rxdb-connection.ts"
  ]
}
