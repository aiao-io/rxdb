{
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/dev-rxdb-electron-test",
    "types": ["vitest/globals", "node"],
    "rootDir": ".",
    "tsBuildInfoFile": "../../dist/out-tsc/dev-rxdb-electron-test.tsbuildinfo"
  },
  "extends": "./tsconfig.json",
  "include": [
    "src-electron/**/*.spec.ts",
    "src-electron/**/*.ts",
    // desktop-sqlite-bridge.spec.ts 直接 import 这个脚本来断言 bundleOptions，
    // 不列进来 tsc 就报 TS6307（引用了不属于本 project 的文件）。
    "tools/**/*.mjs",
    "src/app/connect-wa-sqlite-adapter.ts",
    "src/app/locale.ts",
    "src/app/rxdb-connection.ts"
  ],
  // US-210 起 `@aiao/rxdb-adapter-desktop` 在 tsconfig.base.json 里有了指向源码的 paths，
  // 于是 tsc 会把它当成本 project 的文件解析（TS6059/TS6307）。声明成 project reference，
  // 它才被认成「别的 project 的产物」——tsconfig.app.json 早就这么引了，这里补齐。
  "references": [
    {
      "path": "../../packages/rxdb-adapter-desktop/tsconfig.lib.json"
    }
  ]
}
