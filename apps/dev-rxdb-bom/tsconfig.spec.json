{
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "emitDeclarationOnly": false,
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "extends": "../../tsconfig.base.json",
  "files": ["src/test-setup.ts"],
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/**/*.ts"
  ],
  "references": [
    { "path": "../../packages/rxdb-plugin-bom/tsconfig.lib.json" },
    { "path": "../../packages/rxdb-adapter-wa-sqlite/tsconfig.lib.json" },
    { "path": "../../packages/rxdb-adapter-sqlite-core/tsconfig.lib.json" },
    { "path": "../../packages/rxdb/tsconfig.lib.json" },
    { "path": "../../packages/utils/tsconfig.lib.json" },
    { "path": "../../packages/rxdb-angular/tsconfig.lib.json" }
  ]
}
