{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["aiao-media"],
  "name": "aiao-media-e2e",
  "projectType": "application",
  "sourceRoot": "apps/aiao-media-e2e/src",
  "tags": ["product:media", "type:e2e"],
  "targets": {
    "e2e": {
      "executor": "nx:noop",
      "dependsOn": ["local-first-e2e"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/aiao-media-e2e",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    },
    "image-mvp-e2e": {
      "executor": "nx:noop",
      "dependsOn": ["local-first-e2e"]
    },
    "local-first-e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["aiao-media:offline-assets"],
      "options": {
        "command": "pnpm exec playwright test -c apps/aiao-media-e2e/local-first.config.ts",
        "cwd": "."
      }
    },
    "supabase-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["aiao-media:supabase-migrate"],
      "options": {
        "command": "pnpm exec playwright test -c apps/aiao-media-e2e/supabase-local.config.ts",
        "cwd": "."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/aiao-media-e2e",
        "command": "eslint . --max-warnings=0"
      }
    },
    "upgrade-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["aiao-media:offline-assets"],
      "options": {
        "cwd": ".",
        "command": "pnpm exec playwright test -c apps/aiao-media-e2e/upgrade.config.ts"
      }
    },
    "product-e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec playwright test -c apps/aiao-media-e2e/local-product.config.ts",
        "cwd": "."
      },
      "dependsOn": ["aiao-media:supabase-migrate"],
      "cache": false
    },
    "offline-update-e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["aiao-media:offline-assets"],
      "options": {
        "command": "pnpm exec playwright test -c apps/aiao-media-e2e/offline-update.config.ts",
        "cwd": "."
      }
    }
  }
}
