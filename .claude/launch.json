      "autoPort": true
    },
    {
      "name": "dev-rxdb-react",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm nx serve dev-rxdb-react --port=${PORT:-4201}"
      ],
      "autoPort": true
    },
    {
      "name": "dev-rxdb-vue",
      "runtimeExecutable": "sh",
