{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "// targets": "to see all targets run: nx show project bom-workspace --web",
  "name": "bom-workspace",
  "prefix": "bom",
  "projectType": "library",
  "sourceRoot": "modules/bom-workspace/src",
  "tags": ["type:ui", "scope:bom"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "modules/bom-workspace"
      }
    },
    "spec-typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project modules/bom-workspace/tsconfig.spec.json --noEmit"
      }
    }
  }
}
