diff --git a/aiao-desktop/apps/e2e/src/harness/network-standin.mjs b/aiao-desktop/apps/e2e/src/harness/network-standin.mjs
new file mode 100644
index 00000000..1456348d
--- /dev/null
+++ b/aiao-desktop/apps/e2e/src/harness/network-standin.mjs
@@ -0,0 +1,100 @@
+import { execFile } from 'node:child_process';
+import { createReadStream, existsSync, statSync } from 'node:fs';
+import { mkdtemp, readFile, rm } from 'node:fs/promises';
+import { createServer } from 'node:https';
+import { tmpdir } from 'node:os';
+import { extname, join, normalize } from 'node:path';
+import { promisify } from 'node:util';
+
+import { contentTypes, isolationHeaders } from '../fixtures/artifact-server.mjs';
+
+/** 证书只用于本次测试上下文，不安装到系统信任库，读取后立即删除临时文件。 */
+async function testCertificate() {
+  const directory = await mkdtemp(join(tmpdir(), 'aiao-standin-tls-'));
+  const key = join(directory, 'key.pem');
+  const cert = join(directory, 'cert.pem');
+  try {
+    await promisify(execFile)('openssl', [
+      'req',
+      '-x509',
+      '-newkey',
+      'rsa:2048',
+      '-nodes',
+      '-days',
+      '1',
+      '-subj',
+      '/CN=127.0.0.1',
+      '-addext',
+      'subjectAltName=IP:127.0.0.1',
+      '-keyout',
+      key,
+      '-out',
+      cert
+    ]);
+    const [keyBytes, certBytes] = await Promise.all([readFile(key), readFile(cert)]);
+    return { key: keyBytes, cert: certBytes };
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+}
+
+/** 在独立的 loopback Origin 托管替身，避免 Firefox 无法操作 route.fulfill 生成的跨源文档。 */
+export async function startStandinServer({ scriptsRoot, document, offline = () => false }) {
+  const server = createServer(await testCertificate(), (request, response) => {
+    if (offline()) {
+      request.socket.destroy();
+      return;
+    }
+    const pathname = decodeURIComponent(new URL(request.url ?? '/', 'http://localhost').pathname);
+    const headers = {
+      ...isolationHeaders,
+      'Cross-Origin-Resource-Policy': 'cross-origin',
+      'Cache-Control': 'no-store'
+    };
+    if (pathname === '/') {
+      response.writeHead(200, { ...headers, 'Content-Type': contentTypes['.html'] });
+      response.end(document());
+      return;
+    }
+    const script = pathname.startsWith('/__standin/orbit/') ? pathname.slice('/__standin/orbit/'.length) : null;
+    const file = script === null ? '' : normalize(join(scriptsRoot, script));
+    if (!file.startsWith(`${scriptsRoot}/`) || !existsSync(file) || !statSync(file).isFile()) {
+      response.writeHead(404);
+      response.end('Not found');
+      return;
+    }
+    response.writeHead(200, { ...headers, 'Content-Type': contentTypes[extname(file)] ?? 'application/octet-stream' });
+    createReadStream(file).pipe(response);
+  });
+  await new Promise((resolve, reject) => {
+    server.once('error', reject);
+    server.listen(0, '127.0.0.1', resolve);
+  });
+  const address = server.address();
+  if (!address || typeof address === 'string') throw new Error('替身服务器未取得端口');
+  return {
+    origin: `https://127.0.0.1:${address.port}`,
+    async close() {
+      server.closeAllConnections();
+      await new Promise((resolve, reject) => server.close(error => (error ? reject(error) : resolve())));
+    }
+  };
+}
+
+/** 仅替换被测上下文里的应用 Origin；真实跨源文档由 HTTPS 返回，产品产物与允许来源的推导逻辑原样使用。 */
+export async function installNetworkStandin(
+  context,
+  { desktopOrigin, originalOrigin, scriptsRoot, document, offline, allowedOrigins }
+) {
+  const server = await startStandinServer({ scriptsRoot, document, offline });
+  allowedOrigins.add(server.origin);
+  const rewriteSource = source => source.replaceAll(originalOrigin, server.origin);
+  await context.route(
+    url => url.origin === desktopOrigin && url.pathname.endsWith('.js'),
+    async route => {
+      const response = await route.fetch();
+      await route.fulfill({ response, body: rewriteSource(await response.text()) });
+    }
+  );
+  return { ...server, rewriteSource };
+}
diff --git a/aiao-desktop/apps/e2e/src/harness/network-standin.spec.mjs b/aiao-desktop/apps/e2e/src/harness/network-standin.spec.mjs
new file mode 100644
index 00000000..a0a3f153
--- /dev/null
+++ b/aiao-desktop/apps/e2e/src/harness/network-standin.spec.mjs
@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { get } from 'node:https';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import test from 'node:test';
+
+import { startStandinServer } from './network-standin.mjs';
+
+const read = url =>
+  new Promise((resolve, reject) => {
+    get(url, { rejectUnauthorized: false }, response => {
+      let text = '';
+      response.setEncoding('utf8');
+      response.on('data', chunk => {
+        text += chunk;
+      });
+      response.on('end', () => resolve({ status: response.statusCode, headers: response.headers, text }));
+      response.on('error', reject);
+    }).on('error', reject);
+  });
+
+test('真实跨源替身随当前模式生成文档，脚本正确托管并提供隔离头', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'aiao-network-standin-'));
+  await writeFile(join(root, 'entry.js'), 'export const ready = true;');
+  let mode = 'standard';
+  let documents = 0;
+  const server = await startStandinServer({
+    scriptsRoot: root,
+    document: () => `<title>${mode}:${++documents}</title>`,
+    offline: () => mode === 'offline'
+  });
+  try {
+    assert.match(server.origin, /^https:\/\/127\.0\.0\.1:/);
+    const first = await read(server.origin);
+    assert.equal(first.text, '<title>standard:1</title>');
+    assert.equal(first.headers['cross-origin-embedder-policy'], 'require-corp');
+    assert.equal(first.headers['cross-origin-resource-policy'], 'cross-origin');
+    mode = 'transparent';
+    assert.equal((await read(`${server.origin}/?channel=two`)).text, '<title>transparent:2</title>');
+    const script = await read(`${server.origin}/__standin/orbit/entry.js`);
+    assert.match(script.headers['content-type'], /javascript/);
+    assert.equal(script.text, 'export const ready = true;');
+    assert.equal((await read(`${server.origin}/__standin/orbit/missing.js`)).status, 404);
+    assert.equal((await read(`${server.origin}/__standin/orbit/%2e%2e%2fprivate.js`)).status, 404);
+    mode = 'offline';
+    await assert.rejects(read(server.origin));
+    mode = 'standard';
+    assert.equal((await read(server.origin)).text, '<title>standard:3</title>');
+  } finally {
+    await server.close();
+    await rm(root, { recursive: true, force: true });
+  }
+  await assert.rejects(read(server.origin));
+});
