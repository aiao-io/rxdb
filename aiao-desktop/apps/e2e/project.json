{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "aiao-desktop-web",
    "orbit"
  ],
  "name": "aiao-desktop-e2e",
  "projectType": "application",
  "sourceRoot": "aiao-desktop/apps/e2e/src",
  "tags": [
    "scope:aiao-desktop",
    "type:e2e"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": [
            "aiao-desktop-web"
          ],
          "target": "build"
        },
        {
          "projects": [
            "orbit"
          ],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "aiao-desktop/apps/e2e",
        "command": "node src/smoke.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-desktop/apps/e2e",
        "command": "eslint . --max-warnings=0"
      }
    }
  }
}
