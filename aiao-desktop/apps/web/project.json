{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "aiao-desktop-web",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "aiao-desktop/apps/web/src",
  "tags": ["scope:aiao-desktop", "type:app", "layer:ui", "angular-app"],
  "targets": {
    "build": {
      "dependsOn": ["^build", "prepare-vendor"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/aiao-desktop/scripts/vivari/**/*",
        "{workspaceRoot}/patches/@vivari__core@1.3.0.patch"
      ],
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "allowedCommonJsDependencies": ["ms"],
        "assets": [
          {
            "glob": "**/*",
            "input": "aiao-desktop/apps/web/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "pdfjs"
          },
          {
            "glob": "**/*",
            "input": "node_modules/@vivari/core/dist/assets",
            "output": "assets"
          },
          {
            "glob": "wa-sqlite*.wasm",
            "input": "node_modules/@subframe7536/sqlite-wasm/dist",
            "output": "sqlite-wasm"
          },
          {
            "glob": "**/*",
            "input": "node_modules/.cache/aiao-desktop/vivari/vendor",
            "output": "vendor",
            "ignore": ["**/*.tmp"]
          }
        ],
        "browser": "aiao-desktop/apps/web/src/main.ts",
        "inlineStyleLanguage": "scss",
        "outputPath": "dist/aiao-desktop/apps/web",
        "styles": ["aiao-desktop/apps/web/src/styles.scss"],
        "tsConfig": "aiao-desktop/apps/web/tsconfig.app.json",
        "define": {
          "import.meta.env.DEV": "false"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "maximumWarning": "1.3mb",
              "maximumError": "1.5mb",
              "type": "initial"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "aiao-desktop/apps/web/ngsw-config.json",
          "optimization": {
            "fonts": {
              "inline": false
            },
            "styles": {
              "inlineCritical": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "import.meta.env.DEV": "true"
          }
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-desktop/apps/web",
        "command": "eslint . --max-warnings=0"
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "aiao-desktop-web:build:production"
        },
        "development": {
          "buildTarget": "aiao-desktop-web:build:development",
          "headers": {
            "Cross-Origin-Opener-Policy": "same-origin",
            "Cross-Origin-Embedder-Policy": "require-corp"
          }
        }
      },
      "dependsOn": [
        "^build",
        {
          "projects": ["aiao-desktop"],
          "target": "dev-ports"
        },
        "prepare-vendor"
      ],
      "options": {
        "port": 4410
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node aiao-desktop/apps/web/tools/serve-static.mjs",
        "parallel": false,
        "env": {
          "PORT": "4411"
        }
      },
      "readyWhen": {
        "url": "http://127.0.0.1:4411"
      }
    },
    "pwa-icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node aiao-desktop/apps/web/tools/generate-pwa-icons.mjs"
      }
    },
    "prepare-vendor": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/aiao-desktop/scripts/vivari/**/*",
        "{workspaceRoot}/patches/@vivari__core@1.3.0.patch",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{workspaceRoot}/node_modules/.cache/aiao-desktop/vivari/vendor"],
      "options": {
        "command": "node aiao-desktop/scripts/vivari/cli.mjs"
      }
    }
  }
}
