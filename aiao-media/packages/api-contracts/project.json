{
  "name": "api-contracts",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "aiao-media/packages/api-contracts/src",
  "projectType": "library",
  "tags": ["scope:aiao-media", "type:contract"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/packages/api-contracts",
        "command": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/packages/api-contracts",
        "command": "vitest run --config vitest.config.mts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/packages/api-contracts",
        "command": "eslint src --max-warnings=0"
      }
    }
  }
}
