{
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "noEmit": false,
    "rewriteRelativeImportExtensions": true
  },
  "extends": "./tsconfig.json",
  "files": ["src/test-setup.ts"],
  "include": [
    "vite.config.mts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
