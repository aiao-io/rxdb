{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": ["rxdb", "rxdb-adapter-wa-sqlite", "rxdb-plugin-storage", "rxdb-adapter-tauri"],
  "name": "aiao-media",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "aiao-media/apps/web/src",
  "tags": ["product:media", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "aiao-media/apps/web/dist",
        "browser": "aiao-media/apps/web/src/main.ts",
        "polyfills": [],
        "tsConfig": "aiao-media/apps/web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "aiao-media/apps/web/public"
          }
        ],
        "styles": ["aiao-media/apps/web/src/styles.css", "aiao-media/apps/web/src/image-mvp.css"],
        "allowedCommonJsDependencies": ["@supabase/supabase-js", "ms"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "510kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": false
          }
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "aiao-media/apps/web/src/local-data/media-devtools.ts",
              "with": "aiao-media/apps/web/src/local-data/media-devtools.development.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "desktop": {
          "outputPath": "aiao-media/apps/web/desktop-dist",
          "fileReplacements": [
            {
              "replace": "aiao-media/apps/web/src/platform/local-backend.ts",
              "with": "aiao-media/apps/web/src/platform/tauri/local-backend.ts"
            }
          ],
          "optimization": true,
          "sourceMap": false,
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "prompt-assets", "prepare-assets", "auth-config"],
      "inputs": [
        "production",
        "^production",
        "{projectRoot}/.env",
        {
          "env": "AIAO_SUPABASE_URL"
        },
        {
          "env": "AIAO_SUPABASE_ANON_KEY"
        }
      ]
    },
    "serve": {
      "dependsOn": ["^build", "prompt-assets", "prepare-assets", "auth-config"],
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "aiao-media:build:production"
        },
        "development": {
          "buildTarget": "aiao-media:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "prebundle": false,
        "proxyConfig": "aiao-media/apps/web/proxy.conf.mjs"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "aiao-media:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "aiao-media:build",
        "port": 4200,
        "staticFilePath": "aiao-media/apps/web/dist/browser",
        "spa": true
      }
    },
    "offline-assets": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": [
        "{projectRoot}/dist/browser/offline-worker.js",
        "{projectRoot}/dist/browser/offline-shell.html",
        "{projectRoot}/dist/browser/offline-manifest.json"
      ],
      "options": {
        "command": "node scripts/build-offline-assets.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "serve-test": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "options": {
        "buildTarget": "aiao-media:build:development",
        "port": 4300,
        "prebundle": false
      },
      "dependsOn": ["prompt-assets", "auth-config"]
    },
    "smoke-production": {
      "executor": "nx:noop",
      "dependsOn": ["aiao-media-e2e:local-first-e2e", "release-check"]
    },
    "prompt-assets": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/build-prompt-assets.mjs",
        "{projectRoot}/src/app/prompts/**/*",
        {
          "externalDependencies": [
            "esbuild",
            "@tiptap/core",
            "@tiptap/pm",
            "@tiptap/extensions",
            "@tiptap/extension-document",
            "@tiptap/extension-paragraph",
            "@tiptap/extension-text",
            "@tiptap/extension-hard-break"
          ]
        }
      ],
      "outputs": ["{projectRoot}/public/prompt-runtime"],
      "options": {
        "command": "node scripts/build-prompt-assets.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "direct-probe-build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/direct-provider-probe/**/*", "{projectRoot}/scripts/direct-provider-probe.mjs"],
      "outputs": ["{projectRoot}/dist/direct-provider-probe"],
      "options": {
        "command": "node scripts/direct-provider-probe.mjs build",
        "cwd": "aiao-media/apps/web"
      }
    },
    "direct-probe-serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["direct-probe-build"],
      "options": {
        "command": "node scripts/direct-provider-probe.mjs serve",
        "cwd": "aiao-media/apps/web"
      }
    },
    "direct-probe-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "eslint scripts/direct-provider-probe*.mjs direct-provider-probe/main.js && node --test scripts/direct-provider-probe.test.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "direct-probe-live": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["direct-probe-build"],
      "options": {
        "command": "node scripts/direct-provider-probe-live.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["release-check"],
      "options": {
        "command": "node scripts/deploy-local-first.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm exec wrangler dev --config deploy/wrangler.json --local --port 4398 --show-interactive-dev-session false",
        "cwd": "aiao-media/apps/web"
      }
    },
    "relay-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint server/cloudflare/local-first-worker.ts server/cloudflare/relay-input.ts server/cloudflare/relay-task.ts server/cloudflare/relay-task-api.ts scripts/local-first-worker.test.mjs scripts/relay-task.test.mjs scripts/cloudflare-stand-ins.mjs && node --test scripts/local-first-worker.test.mjs scripts/relay-task.test.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "deploy-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["release-check"],
      "options": {
        "command": "node scripts/deploy-local-first.mjs --dry-run",
        "cwd": "aiao-media/apps/web"
      }
    },
    "release-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["offline-assets"],
      "options": {
        "command": "node scripts/check-local-first-release.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "auth-config": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/build-supabase-config.mjs",
        "{projectRoot}/src/app/supabase-auth-config.ts",
        "{projectRoot}/.env",
        {
          "env": "AIAO_SUPABASE_URL"
        },
        {
          "env": "AIAO_SUPABASE_ANON_KEY"
        }
      ],
      "outputs": ["{projectRoot}/public/app-config.js"],
      "options": {
        "command": "node --env-file-if-exists=.env scripts/build-supabase-config.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "auth-config-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint scripts/build-supabase-config*.mjs scripts/build-offline-assets.mjs && node --test scripts/build-supabase-config.test.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "prepare-assets": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "{projectRoot}/scripts/prepare-rxdb-assets.mjs",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/packages/rxdb-adapter-wa-sqlite/**/*"
      ],
      "outputs": ["{projectRoot}/public/wa-sqlite/wa-sqlite-async.wasm"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node scripts/prepare-rxdb-assets.mjs"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.server.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "script-test", "requirements-check"],
      "outputs": ["{workspaceRoot}/coverage/aiao-media/apps/web"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "vitest run --config vite.config.mts --project=aiao-media-ui --project=aiao-media-data"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "eslint . --max-warnings=0"
      }
    },
    "requirements-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media",
        "command": "node --test scripts/check-requirements.test.mjs && node scripts/check-requirements.mjs"
      }
    },
    "script-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node --test scripts/build-supabase-config.test.mjs scripts/build-production-supabase-bundle.test.mjs scripts/local-first-worker.test.mjs scripts/relay-task.test.mjs scripts/dev-relay.test.mjs scripts/product-api.test.mjs scripts/product-sync-contract.test.mjs scripts/migration.test.mjs"
      }
    },
    "production-bundle": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/tmp/production-supabase-bundle.sql"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node scripts/build-production-supabase-bundle.mjs"
      }
    },
    "production-bundle-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node --test scripts/build-production-supabase-bundle.test.mjs"
      }
    },
    "supabase-init": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs init",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs up",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-studio": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs studio",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-validate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs validate",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs down",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs status",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs logs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "supabase-migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs migrate",
        "cwd": "aiao-media/apps/web"
      },
      "dependsOn": ["supabase-up"]
    },
    "supabase-serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/supabase-local.mjs serve",
        "cwd": "aiao-media/apps/web"
      },
      "dependsOn": ["supabase-up"],
      "continuous": true
    },
    "supabase-e2e": {
      "executor": "nx:noop",
      "dependsOn": ["aiao-media-e2e:supabase-e2e"]
    },
    "supabase-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["supabase-migrate"],
      "options": {
        "command": "node scripts/test-supabase-local.mjs",
        "cwd": "aiao-media/apps/web"
      }
    },
    "product-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/test-product-local.mjs",
        "cwd": "aiao-media/apps/web"
      },
      "dependsOn": ["supabase-migrate"],
      "cache": false
    },
    "admin-membership": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["supabase-migrate"],
      "options": {
        "command": "node scripts/admin-membership.mjs --local",
        "cwd": "aiao-media/apps/web"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-assets"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "vitest run --config vite.config.mts --project=aiao-media-browser"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "prepare-assets", "script-test", "requirements-check"],
      "outputs": ["{workspaceRoot}/coverage/aiao-media/apps/web"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "vitest run --config vite.config.mts --coverage"
      }
    },
    "platform-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node --test server/cloudflare/*.test.ts"
      }
    },
    "desktop-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "cargo test --manifest-path src-tauri/Cargo.toml"
      }
    },
    "desktop-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "cargo check --manifest-path src-tauri/Cargo.toml"
      }
    },
    "desktop-package": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node scripts/package-desktop.mjs"
      }
    },
    "platform-ui-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "vitest run --config vite.config.mts --project=aiao-media-ui src/app/sync-target.spec.ts src/app/desktop-files.spec.ts"
      }
    },
    "desktop-icons": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "pnpm exec tauri icon src-tauri/icons/brand.svg --output src-tauri/icons"
      }
    },
    "desktop-clean-macros": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "cargo clean --manifest-path src-tauri/Cargo.toml --release"
      }
    },
    "sync-management-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["supabase-migrate"],
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node scripts/test-sync-management-local.mjs"
      }
    },
    "desktop-format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "cargo fmt --manifest-path src-tauri/Cargo.toml"
      }
    },
    "server-test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "node --test --experimental-test-coverage --test-coverage-include='**/server/cloudflare/*.ts' --test-coverage-exclude='**/*.test.ts' --test-coverage-lines=80 server/cloudflare/*.test.ts scripts/local-first-worker.test.mjs scripts/relay-task.test.mjs scripts/dev-relay.test.mjs scripts/product-api.test.mjs"
      }
    },
    "server-typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "aiao-media/apps/web",
        "command": "tsc --noEmit -p tsconfig.server.json"
      }
    }
  }
}
