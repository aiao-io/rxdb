{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["es2022", "dom"],
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "../../../",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/installation.test.ts", "test/node-runtime.test.ts", "test/node-server.test.ts", "test/platform-api.test.ts", "test/platform.test.ts"],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/api-contracts"
    }
  ]
}
