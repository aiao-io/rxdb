{
  "// purpose": "Real type-check for the whole package (src + root *.ts). Non-composite + noEmit so it can include cross-package source fixtures without the -b rootDir constraints. Used by the `typecheck` script.",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    // Node 的 type stripping 按 ESM 规则解析，相对导入必须写全 `.ts`；此处放行以便
    // 根目录的 *.bench.ts 直接 `node --experimental-strip-types` 运行。noEmit 下无产物歧义。
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node", "vite/client", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts"]
  },
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"]
}
