{
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts", "vite/client"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../modules/wujie/tsconfig.lib.json"
    },
    {
      "path": "../packages/utils/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-plugin-search/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-wa-sqlite/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-sqliteai/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-sqlite-wasm/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-sqlite/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-encrypted/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-test/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb-adapter-pglite/tsconfig.lib.json"
    },
    {
      "path": "../packages/rxdb/tsconfig.lib.json"
    }
  ]
}
