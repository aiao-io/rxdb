    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/importMeta", "node"],
    "forceConsistentCasingInFileNames": true,
    "rootDir": "."
  },
  "extends": "../../../tsconfig.base.json",
