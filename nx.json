{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "legacy": true
  },
  "analytics": false,
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/angular:component": {
      "style": "scss"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-angular"
    },
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "scss",
        "linter": "eslint",
        "bundler": "vite"
      },
      "component": {
        "style": "scss"
      },
      "library": {
        "style": "scss",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      }
    }
  },
  "migrate": {
    "agentic": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/**/__tests__/**/*",
      "!{projectRoot}/src/**/test-utils.ts",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "nxCloudId": "6a7b30a94caecff9b5bf52d6",
  "plugins": [
    {
      "options": {
        "build": {
          "buildDepsName": "build-deps",
          "configName": "tsconfig.lib.json",
          "targetName": "build",
          "watchDepsName": "watch-deps"
        },
        "typecheck": {
          "targetName": "typecheck"
        }
      },
      "plugin": "@nx/js/typescript"
    },
    {
      "options": {
        "buildDepsTargetName": "build-deps",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "serveTargetName": "serve",
        "typecheckTargetName": "typecheck",
        "watchDepsTargetName": "watch-deps"
      },
      "plugin": "@nx/vite/plugin"
    },
    {
      "options": {
        "targetName": "lint"
      },
      "plugin": "@nx/eslint/plugin"
    },
    {
      "options": {
        "testTargetName": "test"
      },
      "plugin": "@nx/vitest"
    },
    {
      "// exclude": "dev-rxdb-miniprogram-e2e 要驱动 GUI 版微信开发者工具，只在 macOS / Windows 上存在。插件一看到 playwright.config.ts 就会推断出 e2e / e2e-ci，而 ci-template.yml 用 `nx show projects --withTarget=e2e` 自动组矩阵、runner 全是 ubuntu-latest —— 推断出来就等于把一条在 Linux 上必然红的用例塞进 CI。这里排掉，由该项目自己显式声明 e2e-devtools。dev-rxdb-miniprogram-alipay-probe-e2e 驱动 GUI 版支付宝开发者工具，同理。",
      "exclude": ["apps/dev-rxdb-miniprogram-e2e/**", "apps/dev-rxdb-miniprogram-alipay-probe-e2e/**"],
      "options": {
        "targetName": "e2e"
      },
      "plugin": "@nx/playwright/plugin"
    }
  ],
  "release": {
    "projects": ["packages/*"],
    "releaseTag": {
      "pattern": "v{version}"
    },
    "conventionalCommits": {
      "types": {
        "cleanup": {
          "semverBump": "none",
          "changelog": {
            "title": "🧹 Cleanup"
          }
        },
        "__INVALID__": {
          "semverBump": "none",
          "changelog": {
            "title": "Uncategorized changes"
          }
        }
      }
    },
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "pnpm audit:package-graph && pnpm nx run-many -t build --projects='packages/*'",
      "generatorOptions": {
        "updateDependents": "auto"
      }
    }
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    },
    "coverage": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "test-browser": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}", "{workspaceRoot}/coverage/{projectRoot}-browser"]
    },
