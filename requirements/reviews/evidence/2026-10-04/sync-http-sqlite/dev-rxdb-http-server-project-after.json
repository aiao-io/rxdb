{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [],
  "metadata": {
    "targetGroups": {},
    "js": {
      "packageName": "@aiao/dev-rxdb-http-server",
      "packageVersion": "0.0.1",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "dev-rxdb-http-server",
  "projectType": "application",
  "root": "apps/dev-rxdb-http-server",
  "sourceRoot": "apps/dev-rxdb-http-server/src",
  "tags": ["npm:private", "node-app"],
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production", { "externalDependencies": ["typescript"] }],
      "metadata": {
        "technologies": ["typescript", "typescript"],
        "description": "Runs type-checking for the project.",
        "help": { "command": "pnpm exec tsc --build --help", "example": { "args": ["--force"] } }
      },
      "dependsOn": ["^typecheck"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/dev-rxdb-http-server", "command": "tsc --build --emitDeclarationOnly" },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": ["^build"],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": ["build-deps"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects dev-rxdb-http-server --includeDependencies -- pnpm exec nx build-deps dev-rxdb-http-server"
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{options.outputFile}"],
      "metadata": {
        "technologies": ["eslint"],
        "description": "Runs ESLint on project",
        "help": { "command": "pnpm exec eslint --help", "example": { "options": { "max-warnings": 0 } } }
      },
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/dev-rxdb-http-server", "command": "eslint ." },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/apps/dev-rxdb-http-server"],
      "metadata": {
        "technologies": ["vitest"],
        "description": "Run Vitest tests",
        "help": { "command": "pnpm exec vitest --help", "example": { "options": { "bail": 1, "coverage": true } } }
      },
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "cwd": "apps/dev-rxdb-http-server", "command": "vitest" },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": { "command": "node apps/dev-rxdb-http-server/src/main.ts serve" },
      "configurations": {},
      "parallelism": true
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": { "command": "node apps/dev-rxdb-http-server/src/main.ts seed" },
      "configurations": {},
      "parallelism": true
    },
    "reset": {
      "executor": "nx:run-commands",
      "options": { "command": "node apps/dev-rxdb-http-server/src/main.ts reset seed" },
      "configurations": {},
      "parallelism": true
    }
  }
}
