{
  "root": "packages/rxdb-test",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "syncGenerators": [],
      "cache": true,
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "tsc --project tsconfig.check.json"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "executor": "nx:run-commands",
      "syncGenerators": [],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "vite build && node scripts/verify-public-contract.mjs && tsc --build tsconfig.publish.json",
        "cwd": "packages/rxdb-test"
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-test --includeDependencies -- pnpm exec nx build-deps rxdb-test"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Locally preview Vite production build",
        "help": {
          "command": "pnpm exec vite preview --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "vite preview"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "options": {
        "buildTarget": "build",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "eslint ."
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-test"
      ],
      "metadata": {
        "technologies": [
          "vitest"
        ],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "packages/rxdb-test",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "coverage-acceptance": {
      "dependsOn": [
        "^build"
      ],
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-test"
      ],
      "options": {
        "command": "node scripts/run-coverage-acceptance.mjs",
        "cwd": "packages/rxdb-test"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {},
      "configurations": {},
      "parallelism": true
    }
  },
  "projectType": "library",
  "metadata": {
    "targetGroups": {},
