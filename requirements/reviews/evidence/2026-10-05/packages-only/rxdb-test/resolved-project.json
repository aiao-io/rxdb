          "import": "./dist/transaction/index.js",
          "default": "./dist/transaction/index.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-test",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
