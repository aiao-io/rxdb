{
  "root": "packages/rxdb-plugin-storage",
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "typescript"
        ],
        "description": "Runs type-checking for the project.",
        "help": {
          "command": "pnpm exec tsc --build --help",
          "example": {
            "args": [
              "--force"
            ]
          }
        }
      },
      "dependsOn": [
        "build",
        "^typecheck"
      ],
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "tsc --build --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "vite"
        ],
        "description": "Run Vite build",
        "help": {
          "command": "pnpm exec vite build --help",
          "example": {
            "options": {
              "sourcemap": true,
              "manifest": "manifest.json"
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs . --members"
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-plugin-storage --includeDependencies -- pnpm exec nx build-deps rxdb-plugin-storage"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Locally preview Vite production build",
        "help": {
          "command": "pnpm exec vite preview --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vite preview"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "options": {
        "buildTarget": "build",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "eslint ."
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-plugin-storage"
      ],
      "metadata": {
        "technologies": [
          "vitest"
        ],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "coverage": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-plugin-storage"
      ],
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Run Node tests with coverage before the browser coverage merge."
      },
      "options": {
        "command": "vitest run --coverage",
        "cwd": "packages/rxdb-plugin-storage",
        "env": {
          "VITEST_BROWSER": "false"
        }
      },
      "configurations": {},
      "parallelism": true
    },
    "test-browser": {
      "cache": true,
      "dependsOn": [
        "^build",
        "coverage"
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/coverage/{projectRoot}-browser"
      ],
      "executor": "nx:run-commands",
      "metadata": {
        "description": "Run the browser (real chromium) vitest project. Gated by VITEST_BROWSER=true in vite.config.mts; without this target these specs never run in CI."
      },
      "options": {
        "command": "vitest run --coverage && node ../../scripts/merge-vitest-reports.mjs --node=../../coverage/packages/rxdb-plugin-storage --browser=../../coverage/packages/rxdb-plugin-storage-browser --output=../../coverage/packages/rxdb-plugin-storage",
        "cwd": "packages/rxdb-plugin-storage",
        "env": {
          "VITEST_BROWSER": "true"
        }
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {},
      "configurations": {},
      "parallelism": true
    }
  },
  "projectType": "library",
  "metadata": {
    "targetGroups": {},
    "description": "File and quota storage plugin for Aiao RxDB.",
    "js": {
      "packageName": "@aiao/rxdb-plugin-storage",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./package.json": "./package.json",
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "default": "./dist/index.js"
        },
        "./desktop": {
          "@aiao/source": "./src/desktop.ts",
          "types": "./dist/desktop.d.ts",
          "import": "./dist/desktop.js",
          "default": "./dist/desktop.js"
        },
        "./devtools-desktop": {
          "@aiao/source": "./src/devtools-desktop-filesystem.ts",
          "types": "./dist/devtools-desktop-filesystem.d.ts",
          "import": "./dist/devtools-desktop-filesystem.js",
          "default": "./dist/devtools-desktop-filesystem.js"
        },
        "./devtools-desktop-snapshot": {
          "@aiao/source": "./src/devtools-desktop-snapshot.ts",
          "types": "./dist/devtools-desktop-snapshot.d.ts",
          "import": "./dist/devtools-desktop-snapshot.js",
          "default": "./dist/devtools-desktop-snapshot.js"
        },
        "./testing": {
          "@aiao/source": "./src/testing.ts",
          "types": "./dist/testing.d.ts",
          "import": "./dist/testing.js",
          "default": "./dist/testing.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-plugin-storage",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:storage",
    "npm:opfs",
    "npm:files",
    "npm:local-first",
    "js-lib"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/rxdb-plugin-storage/src",
  "namedInputs": {
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "implicitDependencies": []
}
