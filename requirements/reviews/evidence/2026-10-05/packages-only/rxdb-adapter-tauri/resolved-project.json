{
  "root": "packages/rxdb-adapter-tauri",
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "typescript"
        ],
        "description": "Runs type-checking for the project.",
        "help": {
          "command": "pnpm exec tsc --build --help",
          "example": {
            "args": [
              "--force"
            ]
          }
        }
      },
      "dependsOn": [
        "build",
        "^typecheck"
      ],
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "tsc --build --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "vite"
        ],
        "description": "Run Vite build",
        "help": {
          "command": "pnpm exec vite build --help",
          "example": {
            "options": {
              "sourcemap": true,
              "manifest": "manifest.json"
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs ."
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-adapter-tauri --includeDependencies -- pnpm exec nx build-deps rxdb-adapter-tauri"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Locally preview Vite production build",
        "help": {
          "command": "pnpm exec vite preview --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vite preview"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "options": {
        "buildTarget": "build",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "eslint . --max-warnings=0"
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-adapter-tauri"
      ],
      "metadata": {
        "technologies": [
          "vitest"
        ],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {},
      "configurations": {},
      "parallelism": true
    },
    "cargo-check": {
      "// 下面五个 target 是 Rust 那半的": "本包有两半：renderer 侧的 TS（src/）与 Rust 宿主（rust/）。这五个 target 的 cwd 都是 rust/，输入面也只圈到 rust/ —— 宿主应用的 tauri.conf.json / capabilities/ 不在这里，那些属于 apps/dev-rxdb-tauri 自己的 cargo target。",
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/rust/**/*.rs",
        "{projectRoot}/rust/Cargo.toml",
        "{projectRoot}/rust/Cargo.lock"
      ],
      "metadata": {
        "description": "US-210：Rust 宿主的类型/编译门禁"
      },
      "options": {
        "cwd": "packages/rxdb-adapter-tauri/rust",
        "command": "cargo check --locked --all-targets",
        "parallel": false
      },
      "configurations": {},
      "parallelism": true
    },
    "cargo-clippy": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/rust/**/*.rs",
        "{projectRoot}/rust/Cargo.toml",
        "{projectRoot}/rust/Cargo.lock"
      ],
      "metadata": {
        "description": "US-210：Rust 宿主的 lint 门禁（零警告）"
      },
      "options": {
        "cwd": "packages/rxdb-adapter-tauri/rust",
        "command": "cargo clippy --locked --all-targets -- -D warnings",
        "parallel": false
      },
      "configurations": {},
      "parallelism": true
    },
    "cargo-test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/rust/**/*.rs",
        "{projectRoot}/rust/Cargo.toml",
        "{projectRoot}/rust/Cargo.lock"
      ],
      "metadata": {
        "description": "US-210：Rust 宿主的单元测试"
      },
      "options": {
        "cwd": "packages/rxdb-adapter-tauri/rust",
        "command": "cargo test --locked",
        "parallel": false
      },
      "configurations": {},
      "parallelism": true
    },
    "build-test-host": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/rust/**/*.rs",
        "{projectRoot}/rust/Cargo.toml",
        "{projectRoot}/rust/Cargo.lock",
        {
          "runtime": "node -p process.platform+process.arch"
        }
      ],
      "outputs": [
        "{projectRoot}/rust/target/debug/rxdb_host_stdio",
        "{projectRoot}/rust/target/debug/rxdb_host_stdio.exe"
      ],
      "metadata": {
        "description": "US-210：一致性套件驱动的 stdio 宿主二进制（不进产品包）"
      },
      "options": {
        "cwd": "packages/rxdb-adapter-tauri/rust",
        "command": "cargo build --locked --bin rxdb_host_stdio",
        "parallel": false
      },
      "configurations": {},
      "parallelism": true
    },
    "test-conformance": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "build-test-host",
        "^build"
      ],
      "inputs": [
        "{projectRoot}/conformance/**/*.ts",
        "{projectRoot}/vitest.conformance.mts",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/rust/**/*.rs",
        "{projectRoot}/rust/Cargo.toml",
        "{projectRoot}/rust/Cargo.lock",
        {
          "runtime": "node -p process.platform+process.arch"
        },
        "^production"
      ],
      "metadata": {
        "description": "US-210 AC#2/#3/#5/#7 + US-505 AC#2/#5/#8：Rust 引擎跑 20 个共享套件 + 5 个加密套件，Rust 文件宿主跑 storage 后端一致性套件、52 MiB 流式量级与内存曲线（AC#5）、真实小容量卷的磁盘满（AC#8，Windows 平台跳过）"
      },
      "options": {
        "cwd": "packages/rxdb-adapter-tauri",
        "command": "vitest run --config vitest.conformance.mts",
        "parallel": false
      },
      "configurations": {},
      "parallelism": true
    }
  },
  "projectType": "library",
  "metadata": {
    "targetGroups": {},
    "js": {
      "packageName": "@aiao/rxdb-adapter-tauri",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./package.json": "./package.json",
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "default": "./dist/index.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-adapter-tauri",
  "tags": [
    "npm:public",
    "js-lib"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": []
}
