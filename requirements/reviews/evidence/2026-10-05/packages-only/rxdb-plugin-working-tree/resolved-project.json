{
  "root": "packages/rxdb-plugin-working-tree",
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "typescript"
        ],
        "description": "Runs type-checking for the project.",
        "help": {
          "command": "pnpm exec tsc --build --help",
          "example": {
            "args": [
              "--force"
            ]
          }
        }
      },
      "dependsOn": [
        "build",
        "^typecheck"
      ],
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "// inputs": "同 packages/rxdb：@nx/js/typescript 推断出的 inputs 是 production，把 spec 全排除了，spec 侧的编译期契约改一行也命中缓存。换成 default 把 spec 纳入哈希。",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "tsc --build --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "vite"
        ],
        "description": "Run Vite build",
        "help": {
          "command": "pnpm exec vite build --help",
          "example": {
            "options": {
              "sourcemap": true,
              "manifest": "manifest.json"
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs . --members"
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-plugin-working-tree --includeDependencies -- pnpm exec nx build-deps rxdb-plugin-working-tree"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Locally preview Vite production build",
        "help": {
          "command": "pnpm exec vite preview --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "vite preview"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "options": {
        "buildTarget": "build",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0",
        "cwd": "packages/rxdb-plugin-working-tree"
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/requirements/epics/epic-006-working-tree-commits.md"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-plugin-working-tree"
      ],
      "metadata": {
        "technologies": [
          "vitest"
        ],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "// inputs": "同 packages/rxdb：write-entry-matrix.spec.ts 与 trusted-callsite-capture.spec.ts 用 `?raw` 当场解析 epic-006 的写入口语义矩阵与受信调用点登记表。那个文件不在 {projectRoot} 里，默认 inputs 看不见它。",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {},
      "configurations": {},
      "parallelism": true
    }
  },
  "projectType": "library",
  "metadata": {
    "targetGroups": {},
    "description": "Local working tree and commit history for RxDB: capture uncommitted edits, review diffs, and commit them onto a branch.",
    "js": {
      "packageName": "@aiao/rxdb-plugin-working-tree",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./package.json": "./package.json",
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "default": "./dist/index.js"
        },
        "./testing": {
          "@aiao/source": "./src/working-tree/testing/index.ts",
          "types": "./dist/working-tree/testing/index.d.ts",
          "import": "./dist/working-tree/testing/index.js",
          "default": "./dist/working-tree/testing/index.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-plugin-working-tree",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:local-first",
    "npm:working-tree",
    "npm:commit",
    "npm:version-control",
    "js-lib"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "// namedInputs": "`working-tree/testing/**` 是本包的**产品面**（6 个适配器包消费一致性套件），不是测试文件。默认 production 只排 `*.spec.ts`，正合适——套件本身不带 .spec 后缀，因此改它照样使 build 失效，适配器侧的 conformance 也跟着重跑。这里把 production 原样写出来是为了让这句话有地方说，不是为了改它的值。",
  "sourceRoot": "packages/rxdb-plugin-working-tree/src",
  "implicitDependencies": []
}
