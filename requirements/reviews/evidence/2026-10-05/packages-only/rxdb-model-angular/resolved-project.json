{
  "root": "packages/rxdb-model-angular",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "// command": "用 tsc --build 而不是 tsc -p --noEmit：tsconfig.spec.json 引用了 rxdb-angular/tsconfig.lib.json，而 tsc CLI 不开 useSourceOfProjectReferenceRedirect，会把 @aiao/rxdb-angular 的 import 重定向到 dist/out-tsc/rxdb-angular/lib 的声明产物上。Angular 包的构建走 ng-packagr，写的是 dist/packages/，整条构建链都不产 out-tsc，净树上必报 TS6305（本地绿只是因为历史会话 tsc --build 过）。--build 会先把被引用的复合项目补出来，website 的 api-docs 用的是同一套做法。",
      "options": {
        "cwd": "packages/rxdb-model-angular",
        "command": "tsc --build tsconfig.spec.json --pretty false"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/rxdb-model-angular/ng-package.json",
        "tsConfig": "packages/rxdb-model-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/rxdb-model-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-model-angular --includeDependencies -- pnpm exec nx build-deps rxdb-model-angular"
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-model-angular",
        "command": "eslint ."
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-model-angular"
      ],
      "metadata": {
        "technologies": [
          "vitest"
        ],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "cwd": "packages/rxdb-model-angular",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {
        "packageRoot": "dist/packages/rxdb-model-angular"
      },
      "configurations": {},
      "parallelism": true
    }
  },
  "metadata": {
    "targetGroups": {},
    "description": "Angular UI components for Aiao RxDB Model: metadata-driven entity list, detail, form, dialog, editable table and query builder.",
    "js": {
      "packageName": "@aiao/rxdb-model-angular",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./tailwind.css": "./tailwind.css"
      },
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-model-angular",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:angular",
    "npm:entity",
    "npm:form",
    "npm:table",
    "npm:query-builder",
    "angular-lib"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "prefix": "rxdb",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": [
        "{projectRoot}",
        "dist/{projectRoot}"
      ],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "sourceRoot": "packages/rxdb-model-angular/src",
  "implicitDependencies": []
}
