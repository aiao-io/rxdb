{
  "root": "packages/rxdb-adapter-supabase",
  "targets": {
    "typecheck": {
      "dependsOn": [
        "build",
        "^typecheck"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "metadata": {
        "technologies": [
          "typescript",
          "vite"
        ],
        "description": "Run Vite build",
        "help": {
          "command": "pnpm exec vite build --help",
          "example": {
            "options": {
              "sourcemap": true,
              "manifest": "manifest.json"
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "vite build"
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": [
        "^build"
      ],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": [
        "build-deps"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-adapter-supabase --includeDependencies -- pnpm exec nx build-deps rxdb-adapter-supabase"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Starts Vite dev server",
        "help": {
          "command": "pnpm exec vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "vite"
      },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": [
        "build"
      ],
      "metadata": {
        "technologies": [
          "vite"
        ],
        "description": "Locally preview Vite production build",
        "help": {
          "command": "pnpm exec vite preview --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "vite preview"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": [
        "@nx/js:typescript-sync"
      ],
      "options": {
        "buildTarget": "build",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-supabase",
        "command": "eslint ."
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "^build",
        {
          "target": "test-env",
          "params": "ignore"
        }
      ],
      "inputs": [
        "default",
        "^production"
      ],
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/coverage/packages/rxdb-adapter-supabase"
      ],
      "metadata": {
        "technologies": [
          "vite",
          "vitest",
          "supabase"
        ],
        "description": "Run Vitest tests against the CI Supabase test environment",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "options": {
        "command": "VITE_SUPABASE_URL=$(../../docker/supabase-ci-url.sh) VITE_SUPABASE_KEY=$(grep 'SUPABASE_ANON_KEY:' ../../docker/docker-compose.ci.yml | head -1 | sed 's/.*SUPABASE_ANON_KEY:[[:space:]]*//') vitest",
        "cwd": "packages/rxdb-adapter-supabase"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": [
        "^nx-release-publish"
      ],
      "options": {},
      "configurations": {},
      "parallelism": true
    },
    "test-env": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "metadata": {
        "description": "Start and initialize a checkout-isolated CI Supabase test environment (RV-036: unique compose project/container names + dynamic port, derived from this checkout's path)"
      },
      "options": {
        "cwd": "docker",
        "command": "./supabase-ci-up.sh"
      },
      "configurations": {}
    },
    "test-env-down": {
      "executor": "nx:run-commands",
      "cache": false,
      "parallelism": false,
      "metadata": {
        "description": "Tear down only this checkout's isolated CI Supabase test environment (never touches other checkouts' containers)"
      },
      "options": {
        "cwd": "docker",
        "command": "./supabase-ci-down.sh"
      },
      "configurations": {}
    }
  },
  "projectType": "library",
  "metadata": {
    "targetGroups": {},
    "description": "Supabase adapter for remote data access and reactive synchronization.",
    "js": {
      "packageName": "@aiao/rxdb-adapter-supabase",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./package.json": "./package.json",
        ".": {
          "types": "./dist/index.d.ts",
          "import": "./dist/index.js",
          "default": "./dist/index.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-adapter-supabase",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:supabase",
    "npm:realtime",
    "npm:sync",
    "npm:local-first",
    "js-lib"
  ],
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": []
}
