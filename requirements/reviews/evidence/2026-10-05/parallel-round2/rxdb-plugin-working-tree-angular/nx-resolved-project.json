{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [],
  "metadata": {
    "targetGroups": {},
    "description": "Angular bindings for the Aiao RxDB working tree and commit history plugin.",
    "js": {
      "packageName": "@aiao/rxdb-plugin-working-tree-angular",
      "packageVersion": "0.0.26",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-plugin-working-tree-angular",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "root": "packages/rxdb-plugin-working-tree-angular",
  "sourceRoot": "packages/rxdb-plugin-working-tree-angular/src",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:angular",
    "npm:local-first",
    "npm:working-tree",
    "npm:commit",
    "npm:signals",
    "angular-lib"
  ],
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": ["typescript"]
        }
      ],
      "metadata": {
        "technologies": ["typescript", "typescript"],
        "description": "Runs type-checking for the project.",
        "help": {
          "command": "pnpm exec tsc --build --help",
          "example": {
            "args": ["--force"]
          }
        }
      },
      "dependsOn": ["^typecheck"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree-angular",
        "command": "tsc --build --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/rxdb-plugin-working-tree-angular/ng-package.json",
        "tsConfig": "packages/rxdb-plugin-working-tree-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/rxdb-plugin-working-tree-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": ["^build"],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": ["build-deps"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-plugin-working-tree-angular --includeDependencies -- pnpm exec nx build-deps rxdb-plugin-working-tree-angular"
      },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{options.outputFile}"],
      "metadata": {
        "technologies": ["eslint"],
        "description": "Runs ESLint on project",
        "help": {
          "command": "pnpm exec eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree-angular",
        "command": "eslint ."
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/packages/rxdb-plugin-working-tree-angular"],
      "metadata": {
        "technologies": ["vitest"],
        "description": "Run Vitest tests",
        "help": {
          "command": "pnpm exec vitest --help",
          "example": {
            "options": {
              "bail": 1,
              "coverage": true
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "packages/rxdb-plugin-working-tree-angular",
        "command": "vitest"
      },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {
        "packageRoot": "dist/packages/rxdb-plugin-working-tree-angular"
      },
      "configurations": {},
      "parallelism": true
    }
  }
}
