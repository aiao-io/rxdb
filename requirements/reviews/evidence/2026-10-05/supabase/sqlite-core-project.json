{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [],
  "metadata": {
    "targetGroups": {},
    "description": "Shared SQLite storage primitives for Aiao RxDB adapters.",
    "js": {
      "packageName": "@aiao/rxdb-adapter-sqlite-core",
      "packageVersion": "0.0.26",
      "packageExports": {
        "./package.json": "./package.json",
        ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
        "./desktop-host": {
          "@aiao/source": "./src/desktop-host.ts",
          "types": "./dist/desktop-host.d.ts",
          "import": "./dist/desktop-host.js",
          "default": "./dist/desktop-host.js"
        },
        "./testing": {
          "@aiao/source": "./src/testing.ts",
          "types": "./dist/testing.d.ts",
          "import": "./dist/testing.js",
          "default": "./dist/testing.js"
        }
      },
      "packageMain": "./dist/index.js",
      "isInPackageManagerWorkspaces": true
    }
  },
  "name": "rxdb-adapter-sqlite-core",
  "namedInputs": {
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "projectType": "library",
  "root": "packages/rxdb-adapter-sqlite-core",
  "tags": [
    "npm:public",
    "npm:aiao",
    "npm:rxdb",
    "npm:sqlite",
    "npm:storage",
    "npm:adapter",
    "npm:typescript",
    "js-lib"
  ],
  "targets": {
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/rxdb-adapter-sqlite-core",
        "command": "tsc --build tsconfig.lib.json --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node ../../node_modules/vite/bin/vite.js build",
        "cwd": "packages/rxdb-adapter-sqlite-core"
      },
      "configurations": {},
      "parallelism": true
    },
    "build-deps": {
      "dependsOn": ["^build"],
      "configurations": {},
      "options": {},
      "parallelism": true,
      "executor": "nx:noop"
    },
    "watch-deps": {
      "continuous": true,
      "dependsOn": ["build-deps"],
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx watch --projects rxdb-adapter-sqlite-core --includeDependencies -- pnpm exec nx build-deps rxdb-adapter-sqlite-core"
      },
      "configurations": {},
      "parallelism": true
    },
    "serve": {
      "continuous": true,
      "metadata": {
        "technologies": ["vite"],
        "description": "Starts Vite dev server",
        "help": { "command": "pnpm exec vite --help", "example": { "options": { "port": 3000 } } },
        "deprecated": "Use devTargetName instead. This option will be removed in Nx 22."
      },
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/rxdb-adapter-sqlite-core", "command": "vite" },
      "configurations": {},
      "parallelism": true
    },
    "dev": {
      "continuous": true,
      "metadata": {
        "technologies": ["vite"],
        "description": "Starts Vite dev server",
        "help": { "command": "pnpm exec vite --help", "example": { "options": { "port": 3000 } } }
      },
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/rxdb-adapter-sqlite-core", "command": "vite" },
      "configurations": {},
      "parallelism": true
    },
    "preview": {
      "continuous": true,
      "dependsOn": ["build"],
      "metadata": {
        "technologies": ["vite"],
        "description": "Locally preview Vite production build",
        "help": { "command": "pnpm exec vite preview --help", "example": { "options": { "port": 3000 } } }
      },
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/rxdb-adapter-sqlite-core", "command": "vite preview" },
      "configurations": {},
      "parallelism": true
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": { "buildTarget": "build", "spa": true },
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{options.outputFile}"],
      "metadata": {
        "technologies": ["eslint"],
        "description": "Runs ESLint on project",
        "help": { "command": "pnpm exec eslint --help", "example": { "options": { "max-warnings": 0 } } }
      },
      "executor": "nx:run-commands",
      "options": { "cwd": "packages/rxdb-adapter-sqlite-core", "command": "eslint ." },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/packages/rxdb-adapter-sqlite-core"],
      "metadata": {
        "technologies": ["vitest"],
        "description": "Run Vitest tests",
        "help": { "command": "pnpm exec vitest --help", "example": { "options": { "bail": 1, "coverage": true } } }
      },
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": { "cwd": "packages/rxdb-adapter-sqlite-core", "command": "vitest" },
      "configurations": {},
      "parallelism": true
    },
    "coverage-acceptance": {
      "dependsOn": [
        "^build",
        "rxdb-adapter-wa-sqlite:build-deps",
        "rxdb-adapter-sqlite:build-deps",
        "rxdb-adapter-sqlite-wasm:build-deps",
        "rxdb-adapter-sqliteai:build-deps"
      ],
      "executor": "nx:run-commands",
      "// dependsOn": "这个 target 跑的不止自己，还有 wa-sqlite / sqlite / sqlite-wasm / sqliteai 四个包**自己的** spec（见 vitest.coverage-acceptance.config.mts 的 suiteRoots）。可 `^build` 只沿 sqlite-core 自己的依赖图走，够不到那些 spec 独有的 workspace 包 —— 比如 querycache-identity.spec.ts 要的 @aiao/rxdb-plugin-querycache / @aiao/rxdb-plugin-sync 是 sqlite-wasm 的 devDep，不是 sqlite-core 的。这些包的 exports 指向 dist/index.js，没建出来就是 vite 的 Failed to resolve import，落到 runner 上是 `Failed to import test file`。nx 不支持 `project:^target`，所以挂各包的 `build-deps`（@nx/js/typescript 推断出的 `nx:noop + dependsOn ^build`）—— 只补它们的依赖树，不白建这四个包自己的 dist（spec 走源码）。",
      "cache": false,
      "outputs": ["{workspaceRoot}/coverage/packages/rxdb-adapter-sqlite-core"],
      "options": { "command": "node scripts/run-coverage-acceptance.mjs", "cwd": "packages/rxdb-adapter-sqlite-core" },
      "configurations": {},
      "parallelism": true
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["^nx-release-publish"],
      "options": {},
      "configurations": {},
      "parallelism": true
    }
  }
}
