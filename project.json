{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "@aiao/source",
  "targets": {
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    },
    "migration-release-gate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/check-migration-release-gate.mjs --check"
      }
    },
    "migration-release-gate-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test scripts/check-migration-release-gate.spec.mjs"
      }
    },
    "test-scripts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{workspaceRoot}/scripts/**/*", "{workspaceRoot}/requirements/package-graph.json"],
      "options": {
        "command": "node --test \"scripts/**/*.spec.mjs\""
      }
    },
    "audit-package-graph": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["aiKnowledge"],
      "options": {
        "command": "node scripts/audit/package-graph.mjs --check"
      }
    },
    "ai-example": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "aiKnowledge",
        "{workspaceRoot}/scripts/audit/ai-*.mjs",
        "{workspaceRoot}/packages/rxdb/**/*",
        "{workspaceRoot}/packages/rxdb-adapter-pglite/**/*",
        "{workspaceRoot}/packages/rxdb-plugin-history/**/*",
        "{workspaceRoot}/packages/utils/**/*"
      ],
      "dependsOn": [
        {
          "target": "build",
          "projects": ["rxdb", "rxdb-adapter-pglite", "rxdb-plugin-history"]
        }
      ],
      "options": {
        "command": "node scripts/audit/ai-example.mjs"
      }
    },
    "audit-requirements": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/audit/requirements-consistency.mjs --check"
      }
    },
    "audit-api-surface": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/audit/api-surface.mjs --check"
      }
    },
    "audit-docs-plugins": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/audit/docs-plugin-surface.mjs"
      }
    },
    "lint-ai-artifacts": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/scripts/audit/**/*",
        "{workspaceRoot}/scripts/examples/ai-local/**/*",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "options": {
        "command": "eslint scripts/audit/ai-*.mjs scripts/audit/package-graph*.mjs scripts/audit/lib/package-*.mjs scripts/examples/ai-local/main.ts --max-warnings=0"
      }
    }
  }
}
