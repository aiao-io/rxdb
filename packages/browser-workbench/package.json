{
  "name": "@aiao/browser-workbench",
  "version": "0.0.28",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aiao/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rxdb-catalog": {
      "@aiao/source": "./src/rxdb-catalog.ts",
      "types": "./dist/rxdb-catalog.d.ts",
      "import": "./dist/rxdb-catalog.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@aiao/code-editor": "workspace:^",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "dockview-core": "8.8.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@vscode/codicons": "0.0.46-24",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "fflate": "0.8.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vue": "3.5.44",
    "wasm-git": "0.0.17"
  },
  "license": "MIT",
  "description": "Local-first browser development workbench with OPFS Git, controlled compilation and isolated previews.",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^"
  }
}
