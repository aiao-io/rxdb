{
  "name": "@aiao/rxdb-plugin-board-react",
  "version": "0.0.28",
  "description": "React bindings for the Aiao RxDB board plugin.",
  "homepage": "https://rxdb.aiao.io/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "react",
    "board",
    "kanban",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-board-react"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./board-view.css": "./dist/board-view.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-board-react",
    "tags": [
      "react-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb-plugin-board": "workspace:^"
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^",
    "react": "^19.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-plugin-history": "workspace:*",
    "@aiao/rxdb-plugin-search": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.3.1",
    "vitest": "4.1.11"
  }
}
