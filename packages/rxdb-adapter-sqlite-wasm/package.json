{
  "name": "@aiao/rxdb-adapter-sqlite-wasm",
  "version": "0.0.25",
  "description": "SQLite WASM adapter with browser persistence for Aiao RxDB.",
  "homepage": "https://rxdb.netlify.app/docs/adapters/sqlite-wasm",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "sqlite",
    "wasm",
    "opfs",
    "indexeddb"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-adapter-sqlite-wasm"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-sqlite-wasm",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/utils": "workspace:*",
    "@subframe7536/sqlite-wasm": "^1.3.1"
  },
  "devDependencies": {
    "@aiao/rxdb-test": "workspace:*",
    "ms": "^2.1.3"
  },
  "peerDependencies": {
    "comlink": "^4.4.2"
  },
  "peerDependenciesMeta": {
    "comlink": {
      "optional": true
    }
  }
}
