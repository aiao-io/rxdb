{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rxdb-adapter-desktop",
  "tags": ["js-lib"],
  "targets": {
    "typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "lint": {
      "options": {
        "command": "eslint . --max-warnings=0"
      }
    },
    "build": {
      "options": {
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs ."
      }
    },
    "consumer": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "^build"],
      "options": {
        "command": "node scripts/audit/desktop-adapter-consumer.mjs"
      }
    }
  }
}
