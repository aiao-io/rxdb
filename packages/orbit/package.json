{
  "name": "@aiao/orbit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aiao/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "@aiao/source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./window": {
      "@aiao/source": "./src/window.ts",
      "types": "./dist/window.d.ts",
      "import": "./dist/window.js",
      "default": "./dist/window.js"
    },
    "./react": {
      "@aiao/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./vue": {
      "@aiao/source": "./src/vue.ts",
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./angular": {
      "@aiao/source": "./src/angular.ts",
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js",
      "default": "./dist/angular.js"
    }
  },
  "dependencies": {},
  "description": "Orbit：仓内维护的 Web 应用隔离运行内核。",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "react": "^19.3.1",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "@angular/core": "^22.2.4",
    "react": "^19.3.1",
    "vue": "^3.5.45"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "third-party"
  ]
}
