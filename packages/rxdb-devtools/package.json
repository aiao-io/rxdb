{
  "name": "@aiao/rxdb-devtools",
  "version": "0.0.25",
  "description": "Runtime development tools for inspecting Aiao RxDB databases.",
  "homepage": "https://rxdb.netlify.app/docs/devtools",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "devtools",
    "debugging",
    "database",
    "chrome"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-devtools"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-devtools",
    "tags": [
      "js-lib"
    ]
  },
  "peerDependencies": {
    "@aiao/rxdb": "*",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-encrypted": "workspace:*",
    "vitest": "4.1.10"
  },
  "dependencies": {}
}
