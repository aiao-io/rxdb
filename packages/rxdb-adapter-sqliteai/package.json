{
  "name": "@aiao/rxdb-adapter-sqliteai",
  "version": "0.0.25",
  "description": "SQLiteAI adapter with vector and AI functions for Aiao RxDB.",
  "homepage": "https://rxdb.netlify.app/docs/adapters/sqliteai",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "sqliteai",
    "sqlite",
    "vector-search",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-adapter-sqliteai"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-sqliteai",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@sqliteai/sqlite-wasm": "3.50.4-wasm.1.0.0-sync.1.1.2-vector.1.1.0-memory.1.3.5"
  },
  "devDependencies": {
    "@aiao/rxdb-test": "workspace:*",
    "comlink": "^4.4.2",
    "ms": "^2.1.3"
  }
}
