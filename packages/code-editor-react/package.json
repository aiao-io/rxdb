    "access": "public"
  },
  "nx": {
    "name": "code-editor-react",
    "tags": [
      "react-lib"
    ]
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@aiao/code-editor": "workspace:*",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "codemirror": "^6.0.1"
  }
}
