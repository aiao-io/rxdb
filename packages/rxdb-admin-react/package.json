{
  "name": "@aiao/rxdb-admin-react",
  "version": "0.0.28",
  "description": "React bindings for the Aiao RxDB admin shell: layout, preferences drawer, tab bar, command palette and lock screen.",
  "homepage": "https://rxdb.aiao.io/docs",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "react",
    "admin",
    "preferences",
    "layout",
    "command-palette"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-admin-react"
  },
  "files": [
    "dist",
    "src",
    "tailwind.css",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@aiao/rxdb-admin": "workspace:^",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-admin": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
