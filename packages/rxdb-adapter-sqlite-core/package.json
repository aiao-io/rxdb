{
  "name": "@aiao/rxdb-adapter-sqlite-core",
  "version": "0.0.24",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-sqlite-core",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-encrypted": "workspace:*",
    "@aiao/rxdb-test": "workspace:*",
    "@aiao/utils": "workspace:*",
    "comlink": "^4.4.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "ms": "^2.1.3",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
