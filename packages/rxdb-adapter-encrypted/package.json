{
  "name": "@aiao/rxdb-adapter-encrypted",
  "version": "0.0.25",
  "description": "Transparent AES-GCM field encryption wrapper for Aiao database adapters.",
  "homepage": "https://rxdb.netlify.app/docs/adapters/encrypted",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "encryption",
    "aes-gcm",
    "webcrypto",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-adapter-encrypted"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-encrypted",
    "tags": [
      "js-lib"
    ]
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:*",
    "rxjs": "^7.8.0"
  }
}
