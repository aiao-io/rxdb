{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/__tests__/**/*.ts"
  ],
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../rxdb/tsconfig.lib.json"
    }
  ]
}
