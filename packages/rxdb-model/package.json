{
  "name": "@aiao/rxdb-model",
  "version": "0.0.25",
  "description": "Framework-agnostic entity model core for Aiao RxDB: metadata-driven forms, details, editable tables and query builder.",
  "homepage": "https://rxdb.netlify.app/docs",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "entity",
    "form",
    "table",
    "query-builder"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-model"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "clsx": "^2.1.1",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.1"
  },
  "peerDependencies": {
    "@visactor/vtable": "~1.26.5",
    "@visactor/vtable-editors": "~1.26.5"
  }
}
