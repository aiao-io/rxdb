{
  "name": "@aiao/rxdb-plugin-working-tree-react",
  "version": "0.0.25",
  "description": "React bindings for the Aiao RxDB working tree and commit history plugin.",
  "homepage": "https://rxdb.netlify.app/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "react",
    "local-first",
    "working-tree",
    "commit",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-working-tree-react"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@aiao/rxdb": "*",
    "@aiao/rxdb-plugin-working-tree": "*",
    "@aiao/rxdb-react": "*",
    "react": "^19.2.8",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-plugin-working-tree": "workspace:*",
    "@aiao/rxdb-react": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
