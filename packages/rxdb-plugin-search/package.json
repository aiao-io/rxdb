{
  "name": "@aiao/rxdb-plugin-search",
  "version": "0.0.25",
  "description": "Reactive full-text search plugin for Aiao RxDB, backed by SQLite FTS5 or PostgreSQL tsvector.",
  "homepage": "https://rxdb.netlify.app/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "full-text-search",
    "fts5",
    "sqlite",
    "postgresql",
    "tsvector",
    "search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-search"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-search",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/utils": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-adapter-sqlite": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-wasm": "workspace:*",
    "@aiao/rxdb-adapter-sqliteai": "workspace:*",
    "@aiao/rxdb-adapter-wa-sqlite": "workspace:*"
  },
  "peerDependencies": {
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-wasm": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aiao/rxdb-adapter-pglite": {
      "optional": true
    },
    "@aiao/rxdb-adapter-sqlite-wasm": {
      "optional": true
    }
  }
}
