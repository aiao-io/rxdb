{
  "name": "@aiao/rxdb-adapter-wa-sqlite",
  "version": "0.0.25",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./client": {
      "@aiao/source": "./src/WaSqliteClientBase.ts",
      "types": "./dist/WaSqliteClientBase.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-wa-sqlite",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/utils": "workspace:*",
    "wa-sqlite": "https://codeload.github.com/rhashimoto/wa-sqlite/tar.gz/2bf1c59d89eb6497535a4217bc62fec68a0bb994"
  },
  "devDependencies": {
    "@aiao/rxdb-test": "workspace:*",
    "ms": "^2.1.3"
  }
}
