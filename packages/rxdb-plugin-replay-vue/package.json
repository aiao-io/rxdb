{
  "name": "@aiao/rxdb-plugin-replay-vue",
  "version": "0.0.26",
  "description": "Vue replayer component for the Aiao RxDB session replay plugin.",
  "homepage": "https://rxdb.netlify.app/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "vue",
    "rrweb",
    "session-replay",
    "component"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-replay-vue"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-replay-vue",
    "tags": [
      "vue-lib"
    ]
  },
  "peerDependencies": {
    "@aiao/rxdb-plugin-replay": "*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@aiao/rxdb-plugin-replay": "workspace:*"
  }
}
