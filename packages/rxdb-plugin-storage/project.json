{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "// targets": "to see all targets run: nx show project rxdb-plugin-storage --web",
  "name": "rxdb-plugin-storage",
  "projectType": "library",
  "sourceRoot": "packages/rxdb-plugin-storage/src",
  "// namedInputs": "src/__tests__/storage-backend-parity.suite.ts 是 ./testing 入口的产品代码，不是测试文件：工作区默认的 production 会把整个 __tests__ 排掉，于是「只改共享套件」不使本包 build 失效、也不使 dev-rxdb-tauri 的 test-conformance（inputs 含 ^production）失效——两边一起假绿。",
  "namedInputs": {
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "tags": ["js-lib"],
  "targets": {
    "typecheck": {
      "dependsOn": ["build", "^typecheck"]
    },
    "coverage": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/packages/rxdb-plugin-storage"],
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vitest run --coverage",
        "env": {
          "VITEST_BROWSER": "false"
        }
      },
      "metadata": {
        "description": "Run Node tests with coverage before the browser coverage merge."
      }
    },
    "build": {
      "options": {
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs . --members"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "coverage"],
      "options": {
        "cwd": "packages/rxdb-plugin-storage",
        "command": "vitest run --coverage && node ../../scripts/merge-vitest-reports.mjs --node=../../coverage/packages/rxdb-plugin-storage --browser=../../coverage/packages/rxdb-plugin-storage-browser --output=../../coverage/packages/rxdb-plugin-storage",
        "env": {
          "VITEST_BROWSER": "true"
        }
      },
      "metadata": {
        "description": "Run the browser (real chromium) vitest project. Gated by VITEST_BROWSER=true in vite.config.mts; without this target these specs never run in CI."
      }
    }
  }
}
