{
  "name": "@aiao/rxdb-plugin-storage",
  "version": "0.0.25",
  "description": "File and quota storage plugin for Aiao RxDB.",
  "homepage": "https://rxdb.netlify.app/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "storage",
    "opfs",
    "files",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-storage"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./desktop": {
      "@aiao/source": "./src/desktop.ts",
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "default": "./dist/desktop.js"
    },
    "./devtools-desktop": {
      "@aiao/source": "./src/devtools-desktop-filesystem.ts",
      "types": "./dist/devtools-desktop-filesystem.d.ts",
      "import": "./dist/devtools-desktop-filesystem.js",
      "default": "./dist/devtools-desktop-filesystem.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/utils": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/rxdb-devtools": "workspace:*",
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@aiao/rxdb-adapter-sqlite-core": {
      "optional": true
    },
    "@aiao/rxdb-devtools": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aiao/rxdb-adapter-electron": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/rxdb-adapter-wa-sqlite": "workspace:*",
    "@aiao/rxdb-devtools": "workspace:*",
    "vitest": "4.1.11"
  }
}
