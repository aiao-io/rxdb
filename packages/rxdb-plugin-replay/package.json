{
  "name": "@aiao/rxdb-plugin-replay",
  "version": "0.0.26",
  "description": "Opt-in rrweb session recording and replay for Aiao RxDB, with worktree commit markers and restore-to-commit.",
  "homepage": "https://rxdb.aiao.io/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "rrweb",
    "session-replay",
    "debugging",
    "worktree"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-replay"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-replay",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/utils": "workspace:^",
    "@rrweb/types": "2.1.7",
    "rrweb": "2.1.7",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-plugin-worktree": "workspace:*"
  },
  "peerDependencies": {
    "@aiao/rxdb-plugin-worktree": "workspace:^",
    "@aiao/rxdb": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@aiao/rxdb-plugin-worktree": {
      "optional": true
    }
  }
}
