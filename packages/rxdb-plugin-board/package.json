{
  "name": "@aiao/rxdb-plugin-board",
  "version": "0.0.28",
  "description": "Board entities, kanban domain services and deterministic seeds for Aiao RxDB.",
  "homepage": "https://rxdb.aiao.io/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "board",
    "kanban",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-board"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing/index.ts",
      "import": "./dist/testing.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./board.css": "./board.css"
  },
  "files": [
    "dist",
    "src",
    "board.css",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-board",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb-plugin-search": "workspace:^",
    "@aiao/utils": "workspace:^",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^"
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-wasm": "workspace:*",
    "@aiao/rxdb-plugin-history": "workspace:*"
  }
}
