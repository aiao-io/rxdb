{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rxdb-adapter-pglite",
  "tags": ["js-lib"],
  "targets": {
    "test": {
      "dependsOn": ["^build", { "target": "test-node", "params": "ignore" }]
    },
    "test-node": {
      "cache": true,
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "inputs": ["default", "^production"],
      "options": {
        "command": "vitest src/__tests__/system-schema-migration.spec.ts --browser.enabled=false --reporter=default",
        "cwd": "packages/rxdb-adapter-pglite"
      }
    }
  }
}
