{
  "name": "@aiao/rxdb-adapter-pglite",
  "version": "0.0.25",
  "description": "PGlite adapter for running PostgreSQL locally in the browser.",
  "homepage": "https://rxdb.netlify.app/docs/adapters/pglite",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "pglite",
    "postgresql",
    "local-first",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-adapter-pglite"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./fts": {
      "@aiao/source": "./src/fts/index.ts",
      "types": "./dist/fts/index.d.ts",
      "import": "./dist/fts/index.js",
      "default": "./dist/fts/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-pglite",
    "targets": {
      "test": {
        "parallelism": false
      }
    },
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-encrypted": "workspace:*",
    "@aiao/utils": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "rxjs": "^7.8.2",
    "type-fest": "^5.9.0"
  },
  "devDependencies": {
    "@aiao/rxdb-test": "workspace:*"
  }
}
