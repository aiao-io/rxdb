{
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@aiao/rxdb-test": ["../../packages/rxdb-test/dist/index.d.ts"],
      "@aiao/rxdb-test/encrypted": ["../../packages/rxdb-test/dist/encrypted/index.d.ts"],
      "@aiao/rxdb-test/entities": ["../../packages/rxdb-test/dist/entities/index.d.ts"],
      "@aiao/rxdb-test/shop": ["../../packages/rxdb-test/dist/shop/index.d.ts"]
    },
    "rootDir": "."
  },
  "extends": "../../tsconfig.base.json",
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "src/__tests__/encrypted-test-fixture.ts",
    "src/__tests__/test-utils.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
