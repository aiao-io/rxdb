{
  "name": "@aiao/rxdb-i18n",
  "version": "0.0.28",
  "description": "Reactive local-first client internationalization for Aiao RxDB.",
  "homepage": "https://rxdb.aiao.io/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "i18n",
    "localization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-i18n"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-i18n",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-electron": "workspace:*",
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-plugin-history": "workspace:*",
    "@aiao/rxdb-plugin-working-tree": "workspace:*",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^"
  }
}
