{
  "name": "@aiao/rxdb-plugin-board-vue",
  "version": "0.0.28",
  "description": "Vue bindings for the Aiao RxDB board plugin.",
  "homepage": "https://rxdb.aiao.io/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "vue",
    "board",
    "kanban",
    "composables"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-board-vue"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./board-view.css": "./dist/board-view.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-board-vue",
    "tags": [
      "vue-lib"
    ]
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^",
    "@aiao/rxdb-plugin-board": "workspace:^",
    "rxjs": "^7.8.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-pglite": "workspace:*",
    "@aiao/rxdb-plugin-board": "workspace:*",
    "@aiao/rxdb-plugin-history": "workspace:*",
    "@vue/test-utils": "^2.4.6",
    "vitest": "4.1.11",
    "vue": "^3.5.0"
  }
}
