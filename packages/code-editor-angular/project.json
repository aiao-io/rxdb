{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "code-editor-angular",
  "prefix": "ao",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "sourceRoot": "packages/code-editor-angular/src",
  "tags": ["angular-lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/code-editor-angular/ng-package.json",
        "tsConfig": "packages/code-editor-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/code-editor-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      },
      "dependsOn": ["^nx-release-publish", "link-release-peers"]
    },
    "link-release-peers": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/audit/link-release-peers.mjs packages/code-editor-angular"
      }
    }
  }
}
