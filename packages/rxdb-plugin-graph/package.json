{
  "name": "@aiao/rxdb-plugin-graph",
  "version": "0.0.25",
  "description": "Graph entities and traversal queries for Aiao RxDB.",
  "homepage": "https://rxdb.netlify.app/docs/plugins",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "graph",
    "graph-database",
    "query",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-graph"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "@aiao/source": "./src/sqlite.ts",
      "import": "./dist/sqlite.js",
      "types": "./dist/sqlite.d.ts"
    },
    "./generator": {
      "@aiao/source": "./src/generator/index.ts",
      "import": "./dist/generator.js",
      "types": "./dist/generator/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-graph",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/rxdb-client-generator": "workspace:*",
    "@aiao/utils": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-adapter-wa-sqlite": "workspace:*"
  }
}
