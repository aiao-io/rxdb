{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/__tests__/**/*",
    "src/**/test-utils.ts"
  ],
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../rxdb-client-generator/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-sqlite-core/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-wa-sqlite/tsconfig.lib.json"
    },
    {
      "path": "../rxdb/tsconfig.lib.json"
    }
  ]
}
