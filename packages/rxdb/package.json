{
  "name": "@aiao/rxdb",
  "version": "0.0.25",
  "description": "TypeScript local-first data layer with reactive queries and SQLite adapters.",
  "homepage": "https://rxdb.netlify.app/docs/getting-started",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "local-first",
    "offline-first",
    "reactive-database",
    "rxjs",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/utils": "workspace:*",
    "rxjs": "^7.8.2",
    "type-fest": "^5.8.0",
    "uuid": "^14.0.2"
  }
}
