{
  "name": "@aiao/rxdb-plugin-workspace",
  "version": "0.0.25",
  "description": "Staging, commit, and restore workflows for Aiao RxDB.",
  "homepage": "https://rxdb.netlify.app/docs/collaboration",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "workspace",
    "version-control",
    "undo-redo",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-workspace"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-workspace",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "idb-keyval": "^6.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aiao/rxdb-adapter-wa-sqlite": "workspace:*"
  }
}
