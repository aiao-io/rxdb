{
  "name": "@aiao/rxdb-plugin-p2p-files",
  "version": "0.0.28",
  "description": "LAN peer-to-peer large file transfer primitives for Aiao RxDB.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aiao/utils": "workspace:^"
  },
  "peerDependencies": {
    "@aiao/rxdb": "workspace:^"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "nx": {
    "name": "rxdb-plugin-p2p-files",
    "tags": [
      "js-lib"
    ]
  }
}
