{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "out-tsc/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node", "vite/client"]
  },
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "vite.config.mts"],
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../utils/tsconfig.lib.json" }, { "path": "../rxdb/tsconfig.lib.json" }]
}
