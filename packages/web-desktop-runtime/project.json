{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "web-desktop-runtime",
  "projectType": "library",
  "sourceRoot": "packages/web-desktop-runtime/src",
  "tags": [
    "js-lib"
  ],
  "targets": {
    "build": {
      "options": {
        "command": "vite build && node ../../scripts/audit/package-api-docs.mjs . --members"
      }
    },
    "typecheck": {
      "dependsOn": [
        "build",
        "^typecheck"
      ]
    },
    "build-fixture": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/fixtures/dist/test-app"
      ],
      "options": {
        "cwd": "packages/web-desktop-runtime",
        "command": "vite build --config fixture.config.mts"
      }
    },
    "test": {
      "dependsOn": [
        "build-fixture",
        "^build"
      ]
    },
    "lint": {
      "options": {
        "command": "eslint . --max-warnings=0"
      }
    }
  }
}
