{
  // US-210：Rust 宿主一致性套件。与 tsconfig.spec.json 分开，因为它跑在 node 环境、
  // 要 `spawn` 一个 Rust 二进制，而 spec 那份只跑纯 renderer 的单测。
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    "outDir": "./out-tsc/conformance",
    "types": ["vitest/globals", "vitest/importMeta", "node", "vitest"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": ["vitest.conformance.mts", "conformance/**/*.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "../rxdb/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-test/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-sqlite-core/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-encrypted/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-plugin-storage/tsconfig.lib.json"
    },
    {
      "path": "../utils/tsconfig.lib.json"
    }
  ]
}
