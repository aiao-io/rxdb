{
  "name": "@aiao/rxdb-vue",
  "version": "0.0.25",
  "description": "Vue integration for Aiao RxDB reactive data.",
  "homepage": "https://rxdb.netlify.app/docs/frameworks/vue",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "vue",
    "rxjs",
    "composables",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/utils": "workspace:*"
  },
  "peerDependencies": {
    "@aiao/rxdb-plugin-graph": "*",
    "rxjs": "^7.8.0",
    "vue": "^3.5.42"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-vue",
    "tags": [
      "vue-lib"
    ]
  },
  "devDependencies": {
    "@aiao/rxdb-plugin-graph": "workspace:*",
    "@aiao/rxdb-test": "workspace:*"
  }
}
