{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/__tests__/**/*.ts"
  ],
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "nx": {
    "sync": {
      "ignoredDependencies": ["rxdb-test"]
    }
  },
  "references": [
    {
      "path": "../utils/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-sqlite-core/tsconfig.lib.json"
    },
    {
      "path": "../rxdb/tsconfig.lib.json"
    },
    {
      "path": "../rxdb-adapter-pglite/tsconfig.lib.json"
    }
  ]
}
