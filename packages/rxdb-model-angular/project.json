{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "rxdb-model-angular",
  "prefix": "rxdb",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "sourceRoot": "packages/rxdb-model-angular/src",
  "tags": ["angular-lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "// command": "用 tsc --build 而不是 tsc -p --noEmit：tsconfig.spec.json 引用了 rxdb-angular/tsconfig.lib.json，而 tsc CLI 不开 useSourceOfProjectReferenceRedirect，会把 @aiao/rxdb-angular 的 import 重定向到 dist/out-tsc/rxdb-angular/lib 的声明产物上。Angular 包的构建走 ng-packagr，写的是 dist/packages/，整条构建链都不产 out-tsc，净树上必报 TS6305（本地绿只是因为历史会话 tsc --build 过）。--build 会先把被引用的复合项目补出来，website 的 api-docs 用的是同一套做法。",
      "options": {
        "cwd": "packages/rxdb-model-angular",
        "command": "tsc --build tsconfig.spec.json --pretty false"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "packages/rxdb-model-angular/ng-package.json",
        "tsConfig": "packages/rxdb-model-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/rxdb-model-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
