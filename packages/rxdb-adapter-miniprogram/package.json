{
  "name": "@aiao/rxdb-adapter-miniprogram",
  "version": "0.0.24",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./assets/wa-sqlite.cjs": {
      "types": "./assets/wa-sqlite.cjs.d.ts",
      "default": "./assets/wa-sqlite.cjs"
    },
    "./assets/wa-sqlite.wasm": "./assets/wa-sqlite.wasm",
    "./runtime": {
      "@aiao/source": "./src/runtime.ts",
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    ".": {
      "@aiao/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-adapter-miniprogram",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "@aiao/rxdb-adapter-sqlite-core": "workspace:*",
    "@aiao/rxdb-adapter-wa-sqlite": "workspace:*",
    "@ungap/structured-clone": "1.3.3",
    "wa-sqlite": "https://codeload.github.com/rhashimoto/wa-sqlite/tar.gz/2bf1c59d89eb6497535a4217bc62fec68a0bb994"
  }
}
