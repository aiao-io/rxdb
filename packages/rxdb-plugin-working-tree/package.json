{
  "name": "@aiao/rxdb-plugin-working-tree",
  "version": "0.0.25",
  "description": "Local working tree and commit history for RxDB: capture uncommitted edits, review diffs, and commit them onto a branch.",
  "homepage": "https://rxdb.netlify.app/docs/getting-started",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "local-first",
    "working-tree",
    "commit",
    "version-control"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/rxdb-plugin-working-tree"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@aiao/source": "./src/working-tree/testing/index.ts",
      "types": "./dist/working-tree/testing/index.d.ts",
      "import": "./dist/working-tree/testing/index.js",
      "default": "./dist/working-tree/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "rxdb-plugin-working-tree",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "@aiao/rxdb": "workspace:*",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
