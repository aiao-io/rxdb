{
  "name": "@aiao/utils",
  "version": "0.0.25",
  "description": "Shared TypeScript utilities for Aiao packages.",
  "homepage": "https://rxdb.netlify.app/docs/",
  "bugs": {
    "url": "https://github.com/aiao-io/rxdb/issues"
  },
  "keywords": [
    "aiao",
    "rxdb",
    "typescript",
    "utilities",
    "library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiao-io/rxdb.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.*",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "nx": {
    "name": "utils",
    "tags": [
      "js-lib"
    ]
  },
  "dependencies": {
    "fastest-levenshtein": "^1.0.16",
    "ms": "^2.1.3",
    "rxjs": "^7.8.2",
    "ts-xor": "^1.3.0"
  }
}
