{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node"]
  },
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.testing.ts"
  ],
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../../packages/rxdb/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/rxdb-plugin-history/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/rxdb-adapter-pglite/tsconfig.lib.json"
    },
    {
      "path": "../../../packages/rxdb-plugin-working-tree/tsconfig.lib.json"
    }
  ]
}
