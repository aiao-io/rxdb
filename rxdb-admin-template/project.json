{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "rxdb-admin-template",
  "projectType": "library",
  "tags": ["product:admin-template", "scope:admin-template", "type:governance"],
  "targets": {
    "requirements-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/check-requirements.mjs"
      }
    },
    "requirements-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node --test scripts/check-requirements.spec.mjs"
      }
    },
    "secrets-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node --test scripts/check-secrets.spec.mjs"
      }
    },
    "secrets-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["rxdb-admin-template-angular", "rxdb-admin-template-react", "rxdb-admin-template-vue"],
          "target": "build"
        }
      ],
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/check-secrets.mjs --tracked --artifact ../dist/apps/rxdb-admin-template-angular --artifact apps/react/dist --artifact apps/vue/dist"
      }
    },
    "local-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/local-stack.mjs up"
      }
    },
    "local-down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/local-stack.mjs down"
      }
    },
    "local-status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/local-stack.mjs status"
      }
    },
    "deploy-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/deploy-local.mjs"
      },
      "dependsOn": ["local-up"]
    },
    "rollback-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/rollback-local.mjs"
      }
    },
    "e2e-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/e2e-deployed.mjs"
      }
    },
    "migration-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/migration-check.mjs"
      }
    },
    "failure-drill": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/failure-drill.mjs"
      }
    },
    "env-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/env-check.mjs"
      }
    },
    "monitor-drill": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/monitor-drill.mjs"
      },
      "dependsOn": [
        {
          "projects": ["admin-collaboration"],
          "target": "build-server"
        }
      ]
    },
    "retention-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/retention-check.mjs"
      },
      "dependsOn": [
        {
          "projects": ["admin-collaboration"],
          "target": "build-server"
        }
      ]
    },
    "rollback-drill": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/rollback-drill.mjs"
      },
      "dependsOn": [
        {
          "projects": ["admin-collaboration"],
          "target": "build-server"
        }
      ]
    },
    "collect-evidence": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node deploy/scripts/collect-evidence.mjs"
      }
    },
    "deploy-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node --test deploy/scripts/*.spec.mjs"
      }
    },
    "dev-ports": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/dev/check-ports.mjs"
      }
    },
    "dev-stack": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "dev-ports",
        {
          "projects": ["admin-collaboration"],
          "target": "build-server"
        }
      ],
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/dev/prepare.mjs"
      }
    },
    "dev-api": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["dev-stack"],
      "readyWhen": {
        "url": "http://127.0.0.1:8088/health"
      },
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/dev/api.mjs"
      }
    },
    "dev-dashboard": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["dev-stack"],
      "readyWhen": {
        "url": "http://127.0.0.1:4209/"
      },
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/dev/dashboard.mjs"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": [
        {
          "target": "dev-dashboard",
          "waitFor": "ready"
        },
        {
          "target": "dev-api",
          "waitFor": "ready"
        },
        {
          "projects": ["rxdb-admin-template-react"],
          "target": "serve",
          "waitFor": "ready"
        },
        {
          "projects": ["rxdb-admin-template-angular"],
          "target": "serve",
          "waitFor": "ready"
        },
        {
          "projects": ["rxdb-admin-template-vue"],
          "target": "serve",
          "waitFor": "ready"
        }
      ],
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node scripts/dev/open-dashboard.mjs"
      }
    },
    "dev-test": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "node --test scripts/dev/*.spec.mjs"
      }
    },
    "test": {
      "executor": "nx:noop",
      "dependsOn": ["requirements-check", "requirements-test", "secrets-test", "deploy-test", "dev-test"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "rxdb-admin-template",
        "command": "eslint scripts deploy --ignore-pattern 'deploy/local/.state/**' --max-warnings=0"
      }
    }
  }
}
